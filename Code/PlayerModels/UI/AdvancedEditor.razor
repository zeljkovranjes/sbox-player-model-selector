@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using PlayerModels.Core
@using PlayerModels.Engine
@inherits Panel
@namespace PlayerModels.UI

<root class="menu-window">
    <ModelPreview @ref="Stage" class="stage" />

    <div class="heading">
        <div class="title-row">
            <div class="title">@( _weaponMode ? $"Editing: {_weaponName}" : "Advanced Editor" )</div>
            @if ( _weaponMode )
            {
                <div class="back-button" Tooltip="Back to editing the player (or double-click the player)" @onclick=@ExitWeaponMode>Back to player</div>
            }
        </div>
        <div class="subtitle">@Hint</div>
        <div class="graph">@GraphVersion</div>
    </div>

    <div class="view-tools">
        @foreach ( var tool in Enum.GetValues<TransformGizmo.Tool>() )
        {
            var shown = tool;
            <div class="tool @( _viewport?.Tool == shown ? "active" : "" )" @onclick=@(() => UseTool( shown ))>@shown</div>
        }
        <div class="gap"></div>
        <div class="tool @( _viewport?.Walking == true ? "active" : "" )" Tooltip="Shift+`" @onclick=@ToggleWalk>Walk</div>
        <div class="tool" Tooltip="Home" @onclick=@(() => _viewport?.FrameAll())>Frame all</div>
    </div>

    @if ( !string.IsNullOrEmpty( _viewport?.Status ) )
    {
        <div class="status">@_viewport.Status</div>
    }

    <div class="side">
        @if ( _weaponMode )
        {
            <UISettingsPane class="options weapon-options" Title=@_weaponName Revision=@HashCode.Combine( _weaponPath, _look, _model )>
                <Body>
                    <SlowScroll><Content>
                        <WeaponEditor @ref="_weaponPanel" Look=@_look Changed=@Changed Weapon=@_weaponPath WeaponModel=@_held?.Model Targets=@_weaponTargets
                                      PointAt=@PointPart HoveredPart=@( _pointedPart ?? _hoveredPart ) Locked=@WeaponsLocked PropsLocked=@WeaponPropsLocked
                                      EffectsLocked=@WeaponEffectsLocked></WeaponEditor>
                    </Content></SlowScroll>
                </Body>
            </UISettingsPane>
        }
        else
        {
        <div class="tabs">
            <div class="tab @( ShownTab == Tab.Look ? "active" : "" )" @onclick=@(() => ShowTab( Tab.Look ))>Look</div>
            <div class="tab @( ShownTab == Tab.Accessories ? "active" : "" )" @onclick=@(() => ShowTab( Tab.Accessories ))>Accessories</div>
            <div class="tab @( ShownTab == Tab.Effects ? "active" : "" )" @onclick=@(() => ShowTab( Tab.Effects ))>Effects</div>
        </div>
        <UISettingsPane class="options" Title=@TabTitle Revision=@HashCode.Combine( ShownTab, _look, _model )>
            <Body>
                <SlowScroll><Content>
                    @if ( ShownTab == Tab.Accessories )
                    {
                        <AccessoryEditor @ref="_itemsPanel" Body=@_model Look=@_look Changed=@Changed Locked=@AccessoriesLocked></AccessoryEditor>
                    }
                    else if ( ShownTab == Tab.Effects )
                    {
                        <LayerEditor Look=@_look Changed=@Changed Stage=@Stage Locked=@EffectsLocked EffectId=@EffectId History=@History Undo=@Undo Redo=@Redo
                                     StartShape=@StartShape></LayerEditor>
                    }
                    else
                    {
                        <LookEditor Advanced=@true Model=@_model Look=@_look Changed=@Changed Pointed=@Point BodyGroupsLocked=@BodyGroupsLocked></LookEditor>
                    }
                </Content></SlowScroll>
            </Body>
        </UISettingsPane>
        }
    </div>

    <div class="bar">
        <SharingPanel T="PlayerLook" Library=@Shared.Looks Noun="look" ModelId=@_look?.Model Current=@CurrentLook
                      Describe=@LookEditor.DescribeLook Workshop=@false></SharingPanel>
        <div class="spacer"></div>
        <div class="action @( _dirty ? "" : "disabled" )" @onclick=@(() => Revert?.Invoke())>Revert</div>
        <div class="action apply @( _dirty ? "" : "disabled" )" @onclick=@(() => Apply?.Invoke())>Apply</div>
        <div class="action" @onclick=@Close>Close</div>
    </div>
</root>

@code
{
    /// <summary>The look being edited now: the page's, which it can replace (Revert).</summary>
    public Func<PlayerLook> LookNow { get; init; }

    /// <summary>That look within what the host allows, for the preview.</summary>
    public Func<PlayerLook> ShownNow { get; init; }

    /// <summary>The model being customised, loaded, once it is.</summary>
    public Func<Model> ModelNow { get; init; }

    /// <summary>Whether there are changes not applied yet.</summary>
    public Func<bool> DirtyNow { get; init; }

    /// <summary>Called after every change to the look.</summary>
    public Action Changed { get; init; }

    /// <summary>Wears the look.</summary>
    public Action Apply { get; init; }

    /// <summary>Goes back to what is worn.</summary>
    public Action Revert { get; init; }

    /// <summary>Whether the host keeps this player's body group choices off.</summary>
    public bool BodyGroupsLocked { get; init; }

    /// <summary>Whether the host keeps this player's items off.</summary>
    public bool AccessoriesLocked { get; init; }

    /// <summary>Whether the host keeps this player's effects off.</summary>
    public bool EffectsLocked { get; init; }

    /// <summary>The effect to open on, by id, on the Effects tab; null opens on the Look tab.</summary>
    public string EffectId { get; init; }

    /// <summary>The steps back and forward through changes to the effects (the page's), and what takes them.</summary>
    public EditHistory History { get; init; }
    public Action Undo { get; init; }
    public Action Redo { get; init; }

    /// <summary>A shape to open the Effects tab's shape creator on (a fork from the Workshop); null to open on the layers.</summary>
    public DrawnShape StartShape { get; init; }

    // The tabs of options down the right
    enum Tab { Look, Accessories, Effects }

    ModelPreview Stage { get; set; }

    PlayerLook _look;
    Model _model;
    bool _dirty;
    Tab? _tabChosen;

    Tab ShownTab => _tabChosen ?? (EffectId is null ? Tab.Look : Tab.Effects);

    string TabTitle => ShownTab switch { Tab.Accessories => "Accessories", Tab.Effects => "Effects", _ => "Customize" };
    PartHighlight? _pointed;
    MenuHold _hold;

    // The view, worked like Blender's (see EditorViewport), and the item selected in it or on the Accessories tab
    EditorViewport _viewport;
    AccessoryEditor _itemsPanel;
    int _selectedItem = -1;
    int _panelSeen = -1;
    int _askedPanel = -1;

    string Hint => _viewport?.Walking == true
        ? "Walking: WASD to fly, Q and E down and up, Shift for speed, drag to look. Shift+` to stop"
        : _weaponMode
            ? "Click a prop or sticker, then G move, R rotate, S scale. Point at a part and right-click it to replace, attach to or hide it. Double-click the player to go back"
            : _held is not null
                ? "Double-click your weapon to design it. Middle-drag orbits, Shift pans, Ctrl or the wheel zooms. Click an item, then G move, R rotate, S scale; X Y Z for an axis, Ctrl snaps"
                : "Middle-drag orbits, Shift pans, Ctrl or the wheel zooms. Click an item, then G move, R rotate, S scale; X Y Z for an axis, Ctrl snaps, type a number. Numpad 1 3 7 for views";

    // Weapon mode: the weapon the player holds in the game, held the same in the preview and designed here (see
    // WeaponEditor), entered by double-clicking it; what is pointed at on it, and what the gizmo moves there
    bool _weaponMode;
    ModelPreview.HeldWeapon? _held;
    string _weaponPath;
    string _weaponName;
    RealTimeSince _sinceHeld = 10f;
    bool _hoverWeapon;
    string _hoveredPart;
    string _pointedPart;
    ItemTargets _itemTargets;
    WeaponTargets _weaponTargets;
    WeaponEditor _weaponPanel;

    // How often the weapon held in the game is looked for again, in seconds; and where weapon mode looks at it from
    const float HeldInterval = 0.5f;
    const float SideYaw = 90f;
    const float SidePitch = 12f;

    static PlayerModels.Components.PlayerModelSelector Selector => PlayerModels.Components.PlayerModelSelector.Find( Game.ActiveScene );

    // Whether the host keeps players' weapon designs, props or effects off (never the host's own)
    static bool WeaponsLocked => !Networking.IsHost && Selector?.BlockWeaponDesigns == true;
    static bool WeaponPropsLocked => !Networking.IsHost && Selector?.BlockWeaponProps == true;
    static bool WeaponEffectsLocked => !Networking.IsHost && Selector?.BlockWeaponEffects == true;

    // Which animation graph system moves the citizen every model is posed from
    string GraphVersion => AnimGraphVersions.Describe( AnimGraphVersions.Of( Stage?.Citizen ) );

    // The menu this window lives in draws under the HUD's health (1050): while it is open it goes over that
    const int AboveHud = 1100;
    Panel _menu;
    InputLock _inputLock;

    PlayerLook CurrentLook => _look is { IsCustomised: true, IsDefault: false } ? _look.Customisation() : null;

    protected override int BuildHash() => HashCode.Combine( _look, _look?.Serialize(), _model, _dirty, ShownTab,
        HashCode.Combine( _viewport?.Tool, _viewport?.Walking, _viewport?.Status, _selectedItem, GraphVersion ),
        HashCode.Combine( _weaponMode, _weaponPath, _weaponName, _hoveredPart, _pointedPart, _weaponTargets?.Selected, _held is null ) );

    protected override void OnAfterTreeRender( bool firstTime )
    {
        base.OnAfterTreeRender( firstTime );

        if ( !firstTime )
            return;

        _hold = FindPopupPanel()?.AddChild<MenuHold>();
        _menu = Game.ActiveScene?.Get<SpawnMenuHost>()?.Panel;
        if ( _menu is not null )
            _menu.Style.ZIndex = AboveHud;

        // The keys are for this window while it is up: the player stays where they are
        _inputLock = Game.ActiveScene?.GetSystem<InputLock>();
        if ( _inputLock is not null )
            _inputLock.IsHeld = true;
    }

    public override void Tick()
    {
        base.Tick();

        _look = LookNow?.Invoke();
        _model = ModelNow?.Invoke();
        _dirty = DirtyNow?.Invoke() ?? false;

        if ( Stage is null || _look is null )
            return;

        Stage.FillsWindow = true;
        _itemTargets ??= new ItemTargets( Stage, () => _look, Changed, () => _selectedItem, SelectItem );
        _weaponTargets ??= new WeaponTargets( () => _look?.DesignFor( _weaponPath ), () => Stage.WeaponRenderer, Changed ) { Selecting = _ => StateHasChanged() };
        if ( _viewport is null )
        {
            _viewport = new EditorViewport( Stage, () => _weaponMode ? _weaponTargets : _itemTargets ) { DoubleClicked = DoubleClicked, RightClicked = RightClicked };
            Stage.Viewport = _viewport;
        }

        SyncSelection();
        FindHeldWeapon();
        Stage.Look = ShownNow?.Invoke() ?? _look;
        Stage.Highlight = ShownTab == Tab.Look && !_weaponMode ? _pointed : null;
        Stage.Weapon = _held;
        Hover();
        Stage.WeaponOutlined = !_weaponMode && _hoverWeapon;
        Stage.WeaponPart = _weaponMode ? _pointedPart ?? _hoveredPart : null;
        _ = Stage.ShowAsync( _look.Model );
    }

    // The weapon the player holds in the game now: the same held in the preview, a few times a second
    void FindHeldWeapon()
    {
        if ( _sinceHeld < HeldInterval )
            return;

        _sinceHeld = 0;
        var player = Game.ActiveScene?.GetAll<Player>().FirstOrDefault( x => x.IsLocalPlayer );
        var citizen = player?.Controller?.Renderer;
        var root = HeldItems.HeldBy( citizen );
        var renderer = root is null ? null : WeaponDresser.MainRenderer( root );
        if ( renderer?.Model is not { } model || !WeaponProp.IsModelPath( model.ResourcePath ) )
        {
            _held = null;
            _weaponPath = null;
            if ( _weaponMode )
                ExitWeaponMode();

            return;
        }

        var held = new ModelPreview.HeldWeapon( model, root.Parent.Name, root.WorldTransform.ToLocal( renderer.WorldTransform ), citizen.GetInt( "holdtype" ) );
        if ( held.Model == _held?.Model && held.Bone == _held?.Bone && held.HoldType == _held?.HoldType )
            return;

        _held = held;
        _weaponPath = model.ResourcePath;
        var weapon = Game.ActiveScene.GetAll<BaseCombatWeapon>().FirstOrDefault( x => x.WorldModel == root );
        _weaponName = string.IsNullOrWhiteSpace( weapon?.DisplayName ) ? WeaponDesign.NameOf( _weaponPath ) : weapon.DisplayName;
        StateHasChanged();
    }

    // What the cursor is over: the weapon, to double-click into; in weapon mode, a part of it
    void Hover()
    {
        var weapon = Stage.WeaponRenderer;
        _hoverWeapon = false;
        var part = (string)null;
        if ( _viewport?.Hovered is { } ray && weapon.IsValid() )
        {
            _hoverWeapon = Hits( ray, weapon.Bounds );
            if ( _weaponMode && _hoverWeapon )
                part = PartAt( ray, weapon );
        }

        if ( part != _hoveredPart )
        {
            _hoveredPart = part;
            StateHasChanged();
        }
    }

    static bool Hits( Ray ray, BBox bounds ) => bounds.Trace( ray, 10000f, out _ );

    // The part of the weapon nearest along ray, by its bounds
    static string PartAt( Ray ray, ModelRenderer weapon )
    {
        string found = null;
        var nearest = float.MaxValue;
        var world = weapon.WorldTransform;
        foreach ( var part in WeaponParts.Of( weapon.Model ) )
        {
            if ( WeaponParts.BoundsOf( weapon.Model, part ) is not { } bounds )
                continue;

            var local = new Ray( world.PointToLocal( ray.Position ), world.Rotation.Inverse * ray.Forward );
            if ( bounds.Trace( local, 10000f, out var distance ) && distance < nearest )
            {
                nearest = distance;
                found = part;
            }
        }

        return found;
    }

    void PointPart( string part )
    {
        _pointedPart = part;
    }

    // Double-clicking the weapon designs it; double-clicking anything else in weapon mode goes back to the player
    void DoubleClicked( Ray ray )
    {
        var weapon = Stage.WeaponRenderer;
        var onWeapon = weapon.IsValid() && Hits( ray, weapon.Bounds );
        if ( !_weaponMode && onWeapon )
            EnterWeaponMode();
        else if ( _weaponMode && !onWeapon )
            ExitWeaponMode();
    }

    void EnterWeaponMode()
    {
        if ( _held is null || !Stage.WeaponRenderer.IsValid() )
            return;

        _weaponMode = true;
        _selectedItem = -1;
        _weaponTargets.Select( -1 );

        // From the weapon's side, a little above: it points ahead, so the front would see it end on
        Stage.View.View( SideYaw, SidePitch );
        _viewport?.Frame( Stage.WeaponRenderer.Bounds );
        StateHasChanged();
    }

    void ExitWeaponMode()
    {
        _weaponMode = false;
        _pointedPart = null;
        ContextMenu.Close();
        _viewport?.FrameAll();
        StateHasChanged();
    }

    // Right-clicking in weapon mode: what can be done to the prop or sticker under the cursor, or the part
    void RightClicked( Ray ray )
    {
        if ( !_weaponMode || _weaponPanel is null )
            return;

        var target = _weaponTargets.At( ray );
        if ( target >= 0 )
        {
            _weaponTargets.Select( target );
            var isProp = target < _weaponTargets.PropCount;
            ContextMenu.Open( this, isProp ? "Prop" : "Sticker", new List<ContextMenu.Entry>
            {
                new( "Edit", "edit", () => _weaponTargets.Select( target ), "Click" ),
                new( "Duplicate", "content_copy", () => _weaponTargets.Duplicate(), "Shift+D" ),
                new( "First-person nudge", "open_with", () => _weaponTargets.Select( target ), null, isProp, "Only props are nudged in first person" ),
                new( "Remove", "delete", () => _weaponTargets.Remove(), "Delete" ),
            } );
            return;
        }

        if ( _hoveredPart is not { } part )
            return;

        var model = Stage.WeaponRenderer?.Model;
        var canHide = WeaponParts.CanHide( model, part );
        var hidden = _look.DesignFor( _weaponPath )?.HiddenParts?.Contains( part ) == true;
        var full = (_look.DesignFor( _weaponPath )?.Props?.Count ?? 0) >= WeaponDesign.MaxProps;
        ContextMenu.Open( this, $"The {part}", new List<ContextMenu.Entry>
        {
            new( "Replace with prop", "swap_horiz", () => _weaponPanel.Replace( part, true ), null, !full, $"A weapon has up to {WeaponDesign.MaxProps} props" ),
            new( "Attach to this part", "attach_file", () => _weaponPanel.Replace( part, false ), null, !full, $"A weapon has up to {WeaponDesign.MaxProps} props" ),
            hidden
                ? new( "Show part", "visibility", () => _weaponPanel.SetHidden( part, false ) )
                : new( "Hide part", "visibility_off", () => _weaponPanel.SetHidden( part, true ), null, canHide, "This weapon can't hide this part" ),
        } );
    }

    void UseTool( TransformGizmo.Tool tool )
    {
        if ( _viewport is not null )
            _viewport.Tool = tool;

        StateHasChanged();
    }

    void ToggleWalk()
    {
        if ( _viewport is not null )
            _viewport.Walking = !_viewport.Walking;

        StateHasChanged();
    }

    // Selected in the view: the Accessories tab opens on it
    void SelectItem( int index )
    {
        _selectedItem = index;
        if ( index >= 0 )
            _tabChosen = Tab.Accessories;

        StateHasChanged();
    }

    // The view and the Accessories tab show the same item: one picked on the tab is the view's, and one picked in the
    // view is asked of the tab once (it loads the item's model first)
    void SyncSelection()
    {
        if ( _itemsPanel is null || !_itemsPanel.IsValid() )
            return;

        var panel = _itemsPanel.Selected;
        if ( panel != _panelSeen )
        {
            _panelSeen = panel;
            _selectedItem = panel;
            _askedPanel = panel;
            return;
        }

        if ( _selectedItem != panel && _askedPanel != _selectedItem )
        {
            _askedPanel = _selectedItem;
            _itemsPanel.Select( _selectedItem );
        }
    }

    void ShowTab( Tab tab )
    {
        _tabChosen = tab;
        StateHasChanged();
    }

    void Point( PartHighlight? part ) => _pointed = part;

    /// <summary>Closes the window. Changes not applied stay on the page's preview, as they were made there.</summary>
    public void Close()
    {
        Delete();
    }

    public override void OnDeleted()
    {
        ContextMenu.Close();
        _hold?.Delete();
        if ( _menu.IsValid() )
            _menu.Style.ZIndex = null;

        if ( _inputLock is not null )
            _inputLock.IsHeld = false;

        base.OnDeleted();
    }
}

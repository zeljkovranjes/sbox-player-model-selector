    // A new layer that shows at once, to change from there
    void AddLayer( LayerKind kind )
    {
        if ( !CanAdd )
            return;

        Effect.Layers.Add( EffectPresets.StartingLayer( kind ) );

        ChooseOnly( Effect.Layers.Count - 1 );
        Changed?.Invoke();
    }

    // A moment shows something by default: a burst of sprites, a light for half a second
    void SetWhen( EffectLayer layer, string when )
    {
        layer.When = when;
        if ( layer.IsMoment && layer.Burst == 0f && layer.ShowFor == 0f )
        {
            layer.Burst = layer.KindIs == LayerKind.Sprite ? 20f : 0f;
            layer.ShowFor = layer.KindIs == LayerKind.Sprite ? 0f : 0.5f;
        }

        Changed?.Invoke();
    }

    // Moves the effect to another place: kept where it is (its offset worked out from where it is now) or onto the place
    void SetAnchor( object value )
    {
        if ( Effect is not { } effect || value is not string chosen )
            return;

        var old = effect.Anchor ?? new EffectAnchor();
        var next = AnchorFrom( chosen, old );
        if ( _keep && Rack() is { } rack && rack.TryGetFrame( old, out var from ) && rack.TryGetFrame( next, out var to ) )
        {
            var here = from.ToWorld( new Transform( new Vector3( old.Forward, old.Left, old.Up ) ) ).Position;
            var offset = to.PointToLocal( here );
            next.Forward = offset.x;
            next.Left = offset.y;
            next.Up = offset.z;
        }

        effect.Anchor = next.Sanitized();
        Changed?.Invoke();
    }

    // The rack wearing the look in the preview: on the model, or on the citizen itself
    EffectRack Rack() => Stage?.Body?.Effects ?? (Stage?.Citizen is { } citizen && citizen.IsValid() ? CitizenEffects.On( citizen )?.Effects : null);

    // An anchor chosen in the list: "j:" a joint, "i:" an item (by the item itself), "w" the weapon held. An item or the
    // weapon falls back to the joint it is on
    EffectAnchor AnchorFrom( string chosen, EffectAnchor old )
    {
        if ( chosen.StartsWith( "i:" ) )
        {
            var item = chosen[ 2.. ];
            var pin = Look.Accessories.FirstOrDefault( x => x.Item == item )?.Pin ?? old.Joint;
            return new EffectAnchor { Kind = nameof( AnchorKind.Item ), Item = item, Joint = pin };
        }

        if ( chosen == "w" )
            return new EffectAnchor { Kind = nameof( AnchorKind.HeldWeapon ), Joint = nameof( Effect.Joint.RightHand ) };

        return new EffectAnchor { Joint = chosen[ 2.. ] };
    }

    static string AnchorValue( EffectAnchor anchor ) => anchor.KindIs switch
    {
        AnchorKind.Item => $"i:{anchor.Item}",
        AnchorKind.HeldWeapon => "w",
        _ => $"j:{anchor.Joint}",
    };

    List<UIDropdown.Item> EffectChoices() => Look.Effects.Select( x => new UIDropdown.Item( string.IsNullOrEmpty( x.Name ) ? x.Id : x.Name, x.Id ) ).ToList();

    List<UIDropdown.Item> AnchorChoices()
    {
        var choices = Enum.GetValues<Effect.Joint>().Select( x => new UIDropdown.Item( JointName( x ), $"j:{x}" ) ).ToList();
        foreach ( var item in Look.Accessories.Select( x => x.Item ).Distinct() )
            choices.Add( new UIDropdown.Item( $"Item: {AccessoryCatalog.Find( item )?.Title ?? item}", $"i:{item}" ) );

        // An item no longer worn stays named, so the list still shows what the effect is set to
        if ( Effect?.Anchor is { Kind: nameof( AnchorKind.Item ) } anchor && Look.Accessories.All( x => x.Item != anchor.Item ) )
            choices.Add( new UIDropdown.Item( "Item no longer worn (its joint)", AnchorValue( anchor ) ) );

        choices.Add( new UIDropdown.Item( "Weapon held (its tip)", "w" ) );
        return choices;
    }


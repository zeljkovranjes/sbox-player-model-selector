@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using PlayerModels.Components
@using PlayerModels.Engine
@inherits Panel
@namespace PlayerModels.UI

<root>
    @if ( Selector is not { } selector )
    {
        return;
    }

    <div class="section-header">Players</div>
    @if ( Others().Count == 0 )
    {
        <div class="note">Nobody else is here. Once players join, you can choose a model for any of them here.</div>
    }
    else
    {
        // Searching only when there is more than a page of them; with one page, nothing is filtered
        var searchPlayers = Others().Count > PerPage;
        @if ( searchPlayers )
        {
            <TextEntry class="search-entry" Placeholder="Search players" Value:bind=@PlayerSearch HasClearButton=@true></TextEntry>
        }

        var players = Matching( Others(), x => x.DisplayName, searchPlayers ? _playerSearch : "" );
        var playerPages = PageCount( players.Count );
        var playerPage = Math.Clamp( _playerPage, 0, playerPages - 1 );

        @if ( players.Count == 0 )
        {
            <div class="note">No players match "@_playerSearch.Trim()".</div>
        }

        @foreach ( var player in OnPage( players, playerPage ) )
        {
            var connection = player;
            var model = selector.PickOf( connection ) ?? "";
            var chosen = selector.IsPickedByHost( connection );
            <div class="row">
                <div class="thumb" style="background-image: url( thumb:@( model == "" ? ModelLoader.CitizenModel : model ) )"></div>
                <div class="player">
                    <div class="name">@connection.DisplayName</div>
                    <div class="detail">@( model == "" ? "Default" : TitleOf?.Invoke( model ) ?? model )@( chosen ? ", chosen by you" : "" )</div>
                </div>
                <div class="button" @onclick=@(() => ChooseFor?.Invoke( connection ))>Choose model</div>
                @if ( chosen )
                {
                    <div class="button" @onclick=@(() => Revert( connection ))>Revert</div>
                }
            </div>
        }

        <Pager Page=@playerPage Pages=@playerPages OnPage=@ShowPlayerPage></Pager>
    }

    <div class="section-header">Models Players Can Wear</div>
    <ToggleRow Label="Models from sbox.game" Value=@( !selector.BlockCloudModels ) OnChanged=@AllowCloud></ToggleRow>
    <ToggleRow Label="Models from mounted games" Value=@( !selector.BlockMountedModels ) OnChanged=@AllowMounted></ToggleRow>
    <ToggleRow Label="Players can add model folders" Value=@( !selector.BlockModelFolders ) OnChanged=@AllowFolders></ToggleRow>
    <div class="setting">
        <div class="label">New sbox.game models per player</div>
        <UIDropdown Items=@Choices( DownloadLimits, selector.DownloadLimit, "" ) Value=@selector.DownloadLimit ValueChanged=@SetDownloadLimit Tokenize=@false></UIDropdown>
    </div>
    <div class="setting">
        <div class="label">Counted over</div>
        <UIDropdown Items=@Choices( DownloadWindows, selector.DownloadMinutes, " minutes" ) Value=@selector.DownloadMinutes ValueChanged=@SetDownloadMinutes Tokenize=@false></UIDropdown>
    </div>
    <div class="note">The default citizen and the game's own models can always be worn. Turning a source off puts anyone wearing one of its models back to the citizen. Model folders only put a game's chosen folders first in its group; every mounted game's characters are offered either way, and you can always use them. Everyone here downloads each sbox.game model a player puts on, so each player other than you brings in only so many new ones in that many minutes; models already on the server don't count.</div>

    <div class="section-header">Mounted Games</div>
    @{ var games = selector.PlayersMounts(); }
    @if ( games.Count == 0 )
    {
        <div class="note">Nobody here has a game mounted. Games players mount show up here, for you to block any of them.</div>
    }
    else
    {
        // Searching only when there is more than a page of them; with one page, nothing is filtered
        var searchGames = games.Count > PerPage;
        @if ( searchGames )
        {
            <TextEntry class="search-entry" Placeholder="Search mounted games" Value:bind=@GameSearch HasClearButton=@true></TextEntry>
        }

        var shownGames = Matching( games, x => x.Title, searchGames ? _gameSearch : "" );
        var gamePages = PageCount( shownGames.Count );
        var gamePage = Math.Clamp( _gamePage, 0, gamePages - 1 );

        @if ( shownGames.Count == 0 )
        {
            <div class="note">No mounted games match "@_gameSearch.Trim()".</div>
        }

        @foreach ( var game in OnPage( shownGames, gamePage ) )
        {
            var ident = game.Ident;
            var gameBlocked = selector.BlockedMounts?.Contains( ident ) == true;
            <div class="row">
                <div class="player">
                    <div class="name">@game.Title</div>
                    <div class="detail">@PlayersText( game.Players )@( gameBlocked ? ", blocked" : "" )</div>
                </div>
                <div class="button" @onclick=@(() => BlockMount( ident, !gameBlocked ))>@( gameBlocked ? "Allow" : "Block" )</div>
            </div>
        }

        <Pager Page=@gamePage Pages=@gamePages OnPage=@ShowGamePage></Pager>
        <div class="note">Nobody can wear models from a blocked game; anyone wearing one goes back to the citizen.</div>
    }

    <div class="section-header">Body Groups</div>
    <ToggleRow Label="Players can change body groups" Value=@( !selector.BlockBodyGroups ) OnChanged=@AllowBodyGroups></ToggleRow>
    <div class="note">Turned off, players' models show their own body groups; what they chose comes back when you turn it on. Nobody can hide the body itself, either way. You always can change yours.</div>

    <div class="section-header">Armature</div>
    <ToggleRow Label="Players can set up armatures" Value=@( !selector.BlockArmature ) OnChanged=@AllowArmature></ToggleRow>
    <div class="note">Turned off, players can't give body parts a bone by hand; bones they picked are dropped, and models that need them show the citizen. You always can.</div>

    <div class="section-header">Blocked Models</div>
    @if ( selector.BlockedModels is not { Count: > 0 } blocked )
    {
        <div class="note">None. Hover a model in the Models grid and click its block icon to keep it off this server.</div>
    }
    else
    {
        // Searching only when there is more than a page of them; with one page, nothing is filtered
        var searchBlocked = blocked.Count > PerPage;
        @if ( searchBlocked )
        {
            <TextEntry class="search-entry" Placeholder="Search blocked models" Value:bind=@BlockedSearch HasClearButton=@true></TextEntry>
        }

        // The latest blocked first
        var models = Matching( blocked.Reverse(), x => $"{TitleOf?.Invoke( x )} {x}", searchBlocked ? _blockedSearch : "" );
        var blockedPages = PageCount( models.Count );
        var blockedPage = Math.Clamp( _blockedPage, 0, blockedPages - 1 );

        @if ( models.Count == 0 )
        {
            <div class="note">No blocked models match "@_blockedSearch.Trim()".</div>
        }

        @foreach ( var model in OnPage( models, blockedPage ) )
        {
            var id = model;
            <div class="row">
                <div class="thumb" style="background-image: url( thumb:@id )"></div>
                <div class="name">@( TitleOf?.Invoke( id ) ?? id )</div>
                <div class="button" @onclick=@(() => Unblock( id ))>Unblock</div>
            </div>
        }

        <Pager Page=@blockedPage Pages=@blockedPages OnPage=@ShowBlockedPage></Pager>
    }

    <div class="note">These settings are saved on your machine and used whenever you host.</div>
</root>

@code
{
    /// <summary>The name to show for a model, from what the window knows of it.</summary>
    [Parameter] public Func<string, string> TitleOf { get; set; }

    /// <summary>Called with the player the host wants to choose a model for.</summary>
    [Parameter] public Action<Connection> ChooseFor { get; set; }

    static PlayerModelSelector Selector => PlayerModelSelector.Find( Game.ActiveScene );

    // The players and the blocked models are shown ten at a time, filtered by what is typed above them
    const int PerPage = 10;
    string _playerSearch = "";
    string _blockedSearch = "";
    string _gameSearch = "";
    int _playerPage;
    int _blockedPage;
    int _gamePage;

    // A new search starts from the first page
    string PlayerSearch
    {
        get => _playerSearch;
        set
        {
            _playerSearch = value ?? "";
            _playerPage = 0;
        }
    }

    string BlockedSearch
    {
        get => _blockedSearch;
        set
        {
            _blockedSearch = value ?? "";
            _blockedPage = 0;
        }
    }

    string GameSearch
    {
        get => _gameSearch;
        set
        {
            _gameSearch = value ?? "";
            _gamePage = 0;
        }
    }

    static string PlayersText( int players ) => players switch
    {
        0 => "Nobody here has it",
        1 => "1 player has it",
        _ => $"{players} players have it",
    };

    static int PageCount( int count ) => Math.Max( 1, (count + PerPage - 1) / PerPage );

    static List<T> Matching<T>( IEnumerable<T> items, Func<T, string> text, string search )
    {
        if ( string.IsNullOrWhiteSpace( search ) )
            return items.ToList();

        return items.Where( x => (text( x ) ?? "").Contains( search.Trim(), StringComparison.OrdinalIgnoreCase ) ).ToList();
    }

    static List<T> OnPage<T>( List<T> items, int page ) => items.Skip( page * PerPage ).Take( PerPage ).ToList();

    void ShowPlayerPage( int page )
    {
        _playerPage = Math.Max( 0, page );
        StateHasChanged();
    }

    void ShowBlockedPage( int page )
    {
        _blockedPage = Math.Max( 0, page );
        StateHasChanged();
    }

    void ShowGamePage( int page )
    {
        _gamePage = Math.Max( 0, page );
        StateHasChanged();
    }

    // Everyone connected but the host
    static List<Connection> Others() => Connection.All.Where( x => x != Connection.Local ).ToList();

    protected override int BuildHash() => HashCode.Combine( HashCode.Combine( Selector?.BlockCloudModels, Selector?.BlockMountedModels, Selector?.BlockModelFolders,
            Selector?.BlockArmature, Selector?.BlockBodyGroups ),
        string.Join( ";", Selector?.BlockedModels ?? Enumerable.Empty<string>() ),
        string.Join( ";", Others().Select( x => $"{x.Id}={Selector?.PickOf( x )}{Selector?.IsPickedByHost( x )}" ) ),
        string.Join( ";", Selector?.PlayersMounts().Select( x => $"{x.Ident}={x.Players}" ) ?? Enumerable.Empty<string>() ),
        string.Join( ";", Selector?.BlockedMounts ?? Enumerable.Empty<string>() ),
        HashCode.Combine( _playerSearch, _blockedSearch, _gameSearch, _playerPage, _blockedPage, _gamePage ) );

    void AllowCloud( bool allow )
    {
        Selector?.SetAllowCloudModels( allow );
        StateHasChanged();
    }

    void AllowMounted( bool allow )
    {
        Selector?.SetAllowMountedModels( allow );
        StateHasChanged();
    }

    // The choices for how many new sbox.game models a player brings in, and over how long
    static readonly int[] DownloadLimits = { 1, 2, 3, 5, 10, 20, 50 };
    static readonly int[] DownloadWindows = { 1, 2, 5, 10, 15, 30, 60 };

    // The choices, with the one set now among them even if it was set to another
    static List<UIDropdown.Item> Choices( int[] choices, int current, string unit )
    {
        return choices.Append( current ).Distinct().OrderBy( x => x ).Select( x => new UIDropdown.Item( $"{x}{unit}", x ) ).ToList();
    }

    void SetDownloadLimit( object value )
    {
        if ( value is int limit )
            Selector?.SetDownloadLimit( limit );

        StateHasChanged();
    }

    void SetDownloadMinutes( object value )
    {
        if ( value is int minutes )
            Selector?.SetDownloadMinutes( minutes );

        StateHasChanged();
    }

    void AllowFolders( bool allow )
    {
        Selector?.SetAllowModelFolders( allow );
        StateHasChanged();
    }

    void AllowBodyGroups( bool allow )
    {
        Selector?.SetAllowBodyGroups( allow );
        StateHasChanged();
    }

    void BlockMount( string ident, bool blocked )
    {
        Selector?.SetMountBlocked( ident, blocked );
        StateHasChanged();
    }

    void AllowArmature( bool allow )
    {
        Selector?.SetAllowArmature( allow );
        StateHasChanged();
    }

    void Unblock( string model )
    {
        Selector?.SetBlocked( model, false );
        StateHasChanged();
    }

    void Revert( Connection connection )
    {
        Selector?.RevertPick( connection );
        StateHasChanged();
    }
}

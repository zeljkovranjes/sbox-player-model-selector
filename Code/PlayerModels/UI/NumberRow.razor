@using System
@using System.Globalization
@using Sandbox
@using Sandbox.UI
@using PlayerModels.Core
@inherits Panel
@namespace PlayerModels.UI

<root>
    <div class="label">@Label</div>
    <UISlider Property=@_so?.GetProperty( Unit.ToString() )></UISlider>
    <TextEntry @ref="_entry" class="number" Tooltip="Type a number or a sum, like 2*3+1" @onsubmit=@Commit @onblur=@Commit></TextEntry>
</root>

@code
{
    /// <summary>
    /// The ranges a number can have, each the range of an effect's field (see <see cref="EffectLayer"/>), a sticker's or a
    /// weapon design's (see <see cref="WeaponDesign"/>).
    /// </summary>
    public enum Field
    {
        Spread, Offset, Size, Reach, Seconds, Rate, Brightness, Speed, Gravity, Beats, Fraction, Angle, Burst, ShowFor, Outline,
        Sweep, SlashArc, SlashWidth, PropOffset, Turn, PropScale, StickerSize, PatternScale, PatternTurn, Scroll, Spin, SkinSpeed, Bands, Nudge,
        NudgeTurn, EmblemPlace, EmblemTurn, EmblemScale, Eraser,
    }

    /// <summary>What the number sets.</summary>
    [Parameter] public string Label { get; set; }

    /// <summary>The number now.</summary>
    [Parameter] public float Value { get; set; }

    /// <summary>Its range.</summary>
    [Parameter] public Field Unit { get; set; }

    /// <summary>Called with the new number while the slider is dragged or a number is typed.</summary>
    [Parameter] public Action<float> OnChanged { get; set; }

    SerializedObject _so;

    // The box beside the slider: it takes a sum (see MathText), worked out when Enter is pressed or it loses focus, and
    // shows the number again whenever it isn't being typed in. The number it shows, and whether what was typed is done with
    TextEntry _entry;
    float _shown = float.NaN;
    bool _typed;

    // The slider edits a property and takes its range from it (as SliderRow does), so each range is a property of its own
    // over the same value; each is the range its field is kept within
    [Range( 0f, EffectLayer.MaxSpread ), Step( 0.5f )] public float Spread { get => Value; set => Set( value ); }
    [Range( -EffectLayer.MaxOffset, EffectLayer.MaxOffset ), Step( 0.25f )] public float Offset { get => Value; set => Set( value ); }
    [Range( EffectLayer.MinSize, EffectLayer.MaxSize ), Step( 0.1f )] public float Size { get => Value; set => Set( value ); }
    [Range( EffectLayer.MinReach, EffectLayer.MaxReach ), Step( 1f )] public float Reach { get => Value; set => Set( value ); }
    [Range( EffectLayer.MinLifetime, EffectLayer.MaxLifetime ), Step( 0.05f )] public float Seconds { get => Value; set => Set( value ); }
    [Range( 0f, EffectLayer.MaxRate ), Step( 1f )] public float Rate { get => Value; set => Set( value ); }
    [Range( 0f, EffectLayer.MaxBrightness ), Step( 0.05f )] public float Brightness { get => Value; set => Set( value ); }
    [Range( 0f, EffectLayer.MaxSpeed ), Step( 1f )] public float Speed { get => Value; set => Set( value ); }
    [Range( -EffectLayer.MaxGravity, EffectLayer.MaxGravity ), Step( 5f )] public float Gravity { get => Value; set => Set( value ); }
    [Range( 0f, EffectLayer.MaxRhythmSpeed ), Step( 0.05f )] public float Beats { get => Value; set => Set( value ); }
    [Range( 0f, 1f ), Step( 0.01f )] public float Fraction { get => Value; set => Set( value ); }
    [Range( 0f, EffectLayer.MaxAngle ), Step( 1f )] public float Angle { get => Value; set => Set( value ); }
    [Range( 0f, EffectLayer.MaxBurst ), Step( 1f )] public float Burst { get => Value; set => Set( value ); }
    [Range( 0f, EffectLayer.MaxShowFor ), Step( 0.05f )] public float ShowFor { get => Value; set => Set( value ); }
    [Range( 0f, Sticker.MaxOutline ), Step( 0.01f )] public float Outline { get => Value; set => Set( value ); }
    [Range( -EffectLayer.MaxSweep, EffectLayer.MaxSweep ), Step( 5f )] public float Sweep { get => Value; set => Set( value ); }
    [Range( EffectLayer.MinSlashArc, EffectLayer.MaxSlashArc ), Step( 5f )] public float SlashArc { get => Value; set => Set( value ); }
    [Range( EffectLayer.MinSlashWidth, EffectLayer.MaxSlashWidth ), Step( 0.01f )] public float SlashWidth { get => Value; set => Set( value ); }
    [Range( -WeaponProp.MostOffset, WeaponProp.MostOffset ), Step( 0.25f )] public float PropOffset { get => Value; set => Set( value ); }
    [Range( -Accessory.MaxTurn, Accessory.MaxTurn ), Step( 1f )] public float Turn { get => Value; set => Set( value ); }
    [Range( WeaponProp.MinScale, WeaponProp.MostScale ), Step( 0.01f )] public float PropScale { get => Value; set => Set( value ); }
    [Range( WeaponSticker.MinSize, WeaponSticker.MaxSize ), Step( 0.1f )] public float StickerSize { get => Value; set => Set( value ); }
    [Range( WeaponSkin.MinScale, WeaponSkin.MaxScale ), Step( 0.05f )] public float PatternScale { get => Value; set => Set( value ); }
    [Range( 0f, 180f ), Step( 1f )] public float PatternTurn { get => Value; set => Set( value ); }
    [Range( -WeaponSkin.MaxScroll, WeaponSkin.MaxScroll ), Step( 0.05f )] public float Scroll { get => Value; set => Set( value ); }
    [Range( -WeaponSkin.MaxSpin, WeaponSkin.MaxSpin ), Step( 0.05f )] public float Spin { get => Value; set => Set( value ); }
    [Range( 0f, WeaponSkin.MaxSpeed ), Step( 0.05f )] public float SkinSpeed { get => Value; set => Set( value ); }
    [Range( WeaponSkin.MinBands, WeaponSkin.MaxBands ), Step( 1f )] public float Bands { get => Value; set => Set( value ); }
    [Range( -WeaponProp.MaxNudge, WeaponProp.MaxNudge ), Step( 0.05f )] public float Nudge { get => Value; set => Set( value ); }
    [Range( -WeaponProp.MaxNudgeTurn, WeaponProp.MaxNudgeTurn ), Step( 1f )] public float NudgeTurn { get => Value; set => Set( value ); }
    [Range( -EmblemLayer.MaxReach, EmblemLayer.MaxReach ), Step( 0.01f )] public float EmblemPlace { get => Value; set => Set( value ); }
    [Range( -EmblemLayer.MaxTurn, EmblemLayer.MaxTurn ), Step( 1f )] public float EmblemTurn { get => Value; set => Set( value ); }
    [Range( EmblemLayer.MinScale, EmblemLayer.MaxScale ), Step( 0.01f )] public float EmblemScale { get => Value; set => Set( value ); }
    [Range( DrawnShape.MinStrokeWidth, DrawnShape.MaxStrokeWidth ), Step( 0.01f )] public float Eraser { get => Value; set => Set( value ); }

    void Set( float value )
    {
        Value = value;
        OnChanged?.Invoke( value );
    }

    // What was typed, worked out and held to the field's range; anything that isn't a number leaves it as it was, and the
    // box shows the number again once it is let go (see Tick)
    void Commit()
    {
        _typed = true;
        if ( _entry is null || !MathText.TryEvaluate( _entry.Text, out var typed ) || _so?.GetProperty( Unit.ToString() ) is not { } property )
            return;

        if ( property.TryGetAttribute<RangeAttribute>( out var range ) )
            typed = Math.Clamp( typed, range.Min, range.Max );

        if ( typed != Value )
            property.SetValue( typed );
    }

    // Every frame while shown: the text is only made again when the number changed or typing ended, so this allocates
    // nothing otherwise
    public override void Tick()
    {
        base.Tick();

        if ( _entry is null || _entry.HasFocus || !_typed && Value == _shown )
            return;

        _typed = false;
        _shown = Value;
        _entry.Text = Value.ToString( "0.##", CultureInfo.InvariantCulture );
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _so ??= TypeLibrary.GetSerializedObject( this );
    }

    protected override int BuildHash() => HashCode.Combine( Label, Unit );
}

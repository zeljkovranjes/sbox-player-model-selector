@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Sandbox
@using Sandbox.UI
@using PlayerModels.Core
@using PlayerModels.Engine
@typeparam T
@inherits Panel
@namespace PlayerModels.UI

<root class="sharing @( Workshop ? "workshop" : "mine" )">
    @if ( Workshop && _details is { } open )
    {
        <div class="top">
            <div class="back" Tooltip="Back to the list" @onclick=@CloseDetails>arrow_back</div>
            <div class="title">@NameOf( open )</div>
        </div>

        <div class="row author">
            @if ( Pictures )
            {
                <SharedPicture class="picture big" Item=@open.Item></SharedPicture>
            }
            <img class="avatar" src="avatar:@open.Author" />
            <div class="shared-text">
                <div class="shared-name">@AuthorOf( open )</div>
                <div class="shared-detail">
                    <div class="shared-changes">@( Describe?.Invoke( open.Item ) )</div>
                </div>
            </div>
            <div class="shared-age">@( $"Shared {Ago( open.Changed )}" )</div>
            <div class="vote @VoteClass( open, 1 )" @onclick=@Bind.Click( VoteUp, open )>thumb_up</div>
            <div class="votes">@open.Up</div>
            <div class="vote @VoteClass( open, -1 )" @onclick=@Bind.Click( VoteDown, open )>thumb_down</div>
            <div class="votes">@open.Down</div>
            <div class="button" @onclick=@Bind.Click( UseOne, open )>Use</div>
            @if ( Fork is not null )
            {
                <div class="button" Tooltip=@ForkTip @onclick=@Bind.Click( ForkOne, open )>Fork</div>
            }
        </div>
        <div class="row actions">
            <div class="spacer"></div>
            @if ( open.IsMine )
            {
                <div class="button @( _busy ? "disabled" : "" )" @onclick=@Bind.Click( TakeDown, open )>Take down</div>
            }
            else
            {
                <div class="button" Tooltip="Hide everything this player shares, on your screen only" @onclick=@Bind.Click( ToggleHiddenOf, open )>@( IsHidden( open ) ? "Unhide author" : "Hide author" )</div>
                @if ( Block is not null )
                {
                    var blocked = IsBlocked?.Invoke( open ) == true;
                    <div class="button" Tooltip="Hide it, and every copy of it, from everyone on your server" @onclick=@Bind.Click( ToggleBlocked, open )>@( blocked ? "Unblock on this server" : "Block on this server" )</div>
                }
            }
        </div>

        @if ( OriginOf?.Invoke( open.Item ) is { } origin )
        {
            <div class="note">@ShapeCreator.BasedOn( origin )</div>
        }
        <div class="description @( open.Description == "" ? "empty" : "" )">@( open.Description == "" ? "No description." : open.Description )</div>

        @if ( _status is not null )
        {
            <div class="status">@_status</div>
        }

        <div class="section-header">@( $"More from {AuthorOf( open )}" )</div>
        <div class="list" @ref="_list">
        @if ( _more is null )
        {
            <div class="note">Looking for what else they shared...</div>
        }
        else if ( !OthersOf( open ).Any() )
        {
            <div class="note">Nothing else shared yet.</div>
        }

        @foreach ( var other in OthersOf( open ).Take( _perPage ) )
        {
            <div class="row shared">
                <div class="shared-text">
                    <div class="shared-name">@NameOf( other.Post.Name )</div>
                    <div class="shared-detail">
                        <div class="shared-changes">@( other.Post.Model == Shared.Everyone ? Capitalised( other.Post.Kind ) : $"{Capitalised( other.Post.Kind )} for {ModelName( other.Post.Model )}" )</div>
                    </div>
                </div>
                <div class="shared-age">@Ago( other.Published )</div>
            </div>
        }
        </div>
    }
    else if ( Workshop )
    {
        <div class="top">
            <div class="back" Tooltip="Back" @onclick=@GoBack>arrow_back</div>
            <div class="intro" Tooltip=@IntroText>@FirstLine( IntroText )</div>
        </div>

        <div class="section-header sorted">
            <div class="heading">Shared @( Noun )s</div>
            <div class="sort">
                <div class="sort-choice @( _newest ? "" : "active" )" Tooltip=@SortTip( false ) @onclick=@SortByTop>Top</div>
                <div class="sort-choice @( _newest ? "active" : "" )" Tooltip=@SortTip( true ) @onclick=@SortByNew>New</div>
            </div>
        </div>

        @if ( Searchable || Facets is not null )
        {
            <div class="row filters">
                @if ( Searchable )
                {
                    <TextEntry class="search-entry" Placeholder=@( $"Search {Noun}s" ) Value:bind=@Search HasClearButton=@true></TextEntry>
                }
                @foreach ( var group in FacetGroups() )
                {
                    var name = group.Key;
                    <ScrollingDropdown Items=@FacetChoices( group ) Value=@( _facets.GetValueOrDefault( name ) ?? "" ) ValueChanged=@Bind.Picked( SetFacet, name ) Tokenize=@false></ScrollingDropdown>
                }
            </div>
        }

        <div class="row code-row">
            <TextEntry class="code-entry" Placeholder=@( $"Paste {A( Noun )} code" ) Value:bind=@_code @onsubmit=@UseCode></TextEntry>
            <div class="button" @onclick=@UseCode>Use code</div>
        </div>

        @if ( _status is not null )
        {
            <div class="status">@_status</div>
        }

        <div class="list" @ref="_list">
        @if ( _loading )
        {
            <div class="note">@( $"Looking for {Noun}s shared{Scope}..." )</div>
        }
        else if ( _listed && _entries.Count == 0 )
        {
            <div class="note">@( $"No one has shared {A( Noun )}{Scope} yet." )</div>
        }
        else if ( _listed && _shown.Count == 0 && Filtering )
        {
            <div class="note">@( $"No {Noun}s match. Clear the search or the filters to see them all." )</div>
        }

        @foreach ( var entry in PageOfEntries )
        {
            var shared = entry;
            <div class="row shared @( IsHidden( shared ) ? "hidden-author" : "" ) @( Pictures ? "pictured" : "" )" @onrightclick=@Bind.Click( RowMenu, shared )>
                @if ( Pictures )
                {
                    <SharedPicture class="picture" Item=@shared.Item></SharedPicture>
                }
                <img class="avatar" src="avatar:@shared.Author" />
                <div class="shared-text">
                    <div class="shared-name">@NameOf( shared )</div>
                    <div class="shared-detail">
                        <div class="shared-author">@AuthorOf( shared )</div>
                        <div class="shared-changes">@( Describe?.Invoke( shared.Item ) )</div>
                    </div>
                </div>
                <div class="shared-age">@Ago( shared.Changed )</div>
                <div class="info" Tooltip="Details" @onclick=@Bind.Click( Detail, shared )>info</div>
                <div class="vote @VoteClass( shared, 1 )" @onclick=@Bind.Click( VoteUp, shared )>thumb_up</div>
                <div class="votes">@shared.Up</div>
                <div class="vote @VoteClass( shared, -1 )" @onclick=@Bind.Click( VoteDown, shared )>thumb_down</div>
                <div class="votes">@shared.Down</div>
                <div class="button" @onclick=@Bind.Click( UseOne, shared )>Use</div>
                @if ( Fork is not null )
                {
                    <div class="button" Tooltip=@ForkTip @onclick=@Bind.Click( ForkOne, shared )>Fork</div>
                }
            </div>
        }
        </div>

        @if ( HiddenCount > 0 )
        {
            <div class="row hidden-row">
                <div class="note">@( HiddenCount == 1 ? "1 is" : $"{HiddenCount} are" ) from players you hid.</div>
                <div class="button" @onclick=@ToggleShowHidden>@( _showHidden ? "Hide them" : "Show them" )</div>
            </div>
        }

        @if ( _loadingMore )
        {
            <div class="note">@( $"Reading more {Noun}s shared{Scope}..." )</div>
        }

        <Pager Page=@_page Pages=@Pages OnPage=@ShowPage More=@MoreToRead></Pager>
    }
    else
    {
        <div class="row">
            <div class="button @( CanShare ? "" : "disabled" )" @onclick=@OpenShare><div class="glyph">share</div>@ShareLabel</div>
            <div class="button icon @( Current is null ? "disabled" : "" )" Tooltip=@( $"Copy code: the {Noun} as a code to paste anywhere" ) @onclick=@CopyCode>content_copy</div>
        </div>

        @if ( ShareNote is { } note )
        {
            <div class="note">@note</div>
        }

        @if ( _status is not null )
        {
            <div class="status">@_status</div>
        }
    }

    @if ( _unresponsive )
    {
        <div class="unresponsive">Facepunch Workshop is currently unresponsive</div>
    }
</root>

@code
{
    /// <summary>Where these are shared: <see cref="Shared.Armatures"/> or <see cref="Shared.Looks"/>.</summary>
    [Parameter] public SharedLibrary<T> Library { get; set; }

    /// <summary>What one is called in the panel's words ("armature", "look"), and in its codes.</summary>
    [Parameter] public string Noun { get; set; } = "design";

    /// <summary>The model they are for, as its look names it.</summary>
    [Parameter] public string ModelId { get; set; }

    /// <summary>What this player has now, shared or copied as it is; null when there is nothing to share.</summary>
    [Parameter] public T Current { get; set; }

    /// <summary>
    /// Puts one on the look being edited (Apply wears it), told whose it is ("Ana's look", "the code"), and says what
    /// happened, for the panel to show.
    /// </summary>
    [Parameter] public Func<T, string, string> Use { get; set; }

    /// <summary>What a row says about one, before when it was shared ("3 parts", "a skin and colours").</summary>
    [Parameter] public Func<T, string> Describe { get; set; }

    /// <summary>
    /// True for the Workshop (a code pasted, and what was shared for the model to rate, use or take down); false for this
    /// player's own, under the page's options (Share mine, Copy code).
    /// </summary>
    [Parameter] public bool Workshop { get; set; }

    /// <summary>Leaves the Workshop, back to the page's options.</summary>
    [Parameter] public Action Back { get; set; }

    /// <summary>
    /// What the things are shared for, as the panel's sentences end ("for this model"); empty for things shared for
    /// everyone (effects, shapes).
    /// </summary>
    [Parameter] public string Scope { get; set; } = " for this model";

    /// <summary>What the button that publishes this player's own says.</summary>
    [Parameter] public string ShareLabel { get; set; } = "Share mine";

    /// <summary>What the Workshop says at its top in place of its own sentence; null for that.</summary>
    [Parameter] public string Intro { get; set; }

    /// <summary>Whether the Workshop has a search box: names, descriptions, authors and what rows say.</summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>
    /// What each thing can be filtered by, as "Group: value" ("Comes from: Head"); the Workshop has a list for each group
    /// found, and one of the #tags its descriptions use. Null for no filters.
    /// </summary>
    [Parameter] public Func<T, IEnumerable<string>> Facets { get; set; }

    /// <summary>Which shares the Workshop lists (the shapes of the shapes and stickers shared, say); null for all of them.</summary>
    [Parameter] public Func<T, bool> Shows { get; set; }

    /// <summary>Whether rows show a picture of what was shared (see <see cref="SharedPicture"/>).</summary>
    [Parameter] public bool Pictures { get; set; }

    /// <summary>
    /// Puts a Workshop share on the look being edited, knowing which share it is (to credit it), in place of
    /// <see cref="Use"/>; says what happened. Null to use <see cref="Use"/>.
    /// </summary>
    [Parameter] public Func<SharedLibrary<T>.Entry, string> UseEntry { get; set; }

    /// <summary>Opens a copy of a share to change and publish as one's own; null for no Fork button.</summary>
    [Parameter] public Action<SharedLibrary<T>.Entry> Fork { get; set; }

    /// <summary>What Fork does, in its tooltip.</summary>
    [Parameter] public string ForkTip { get; set; } = "Open a copy of it to change and publish as your own";

    /// <summary>The share a thing was based on, credited in its details; null for none.</summary>
    [Parameter] public Func<T, ShareOrigin> OriginOf { get; set; }

    /// <summary>Blocks a share on the host's server (true) or lets it show again; null for no Block button (not the host).</summary>
    [Parameter] public Action<SharedLibrary<T>.Entry, bool> Block { get; set; }

    /// <summary>Whether the host blocked a share on their server.</summary>
    [Parameter] public Func<SharedLibrary<T>.Entry, bool> IsBlocked { get; set; }

    // The Workshop's list, a page at a time: as many rows (each RowHeight tall, taller with pictures) as its room holds,
    // so it never scrolls
    const float RowHeight = 34f;
    const float PicturedRowHeight = 48f;
    Panel _list;
    int _page, _perPage = 1;

    List<SharedLibrary<T>.Entry> _entries = new();

    // What the list shows of them: in the order picked (Top or New), less what the players this one hid shared
    List<SharedLibrary<T>.Entry> _shown = new();
    HashSet<long> _hidden = new();
    bool _newest = LocalPrefs.SharesByNewest;
    bool _showHidden;

    // The one whose details show in the Workshop, and what else its author shared (null until listed)
    SharedLibrary<T>.Entry _details;
    List<AuthorIndex.Share> _more;

    // The share window, and whether its boxes were held to their lengths yet (they are made a frame or two after it)
    UIModal _shareModal;
    bool _shareLimited;

    // Whether the service stopped answering, shown as a bar until it answers again; asked again every so often
    const float RetrySeconds = 30f;
    bool _unresponsive;
    RealTimeSince _sinceFailed;
    string _listedFor;
    bool _loading, _listed, _busy;
    string _status;
    string _code;
    int _revision;

    // Loops and named methods rather than lambdas in here: a generic type's lambda can't be carried over a hot reload
    // (LINQ keeps one in a static field once it has run, and the markup's would throw from then on). See Bind
    bool AtLimit => MineCount() >= Library.PerPlayer && Game.SteamId.Value != Shared.Curator;

    int MineCount()
    {
        var mine = 0;
        foreach ( var entry in _entries )
        {
            if ( entry.IsMine )
                mine++;
        }

        return mine;
    }

    // What the list is narrowed to: words searched for, and the value picked in each group of filters ("" for any)
    string _search = "";
    readonly Dictionary<string, string> _facets = new();
    const string TagGroup = "Tag";

    string Search
    {
        get => _search;
        set
        {
            _search = value ?? "";
            _page = 0;
            Arrange();
        }
    }

    bool Filtering => !string.IsNullOrWhiteSpace( _search ) || HasFacet();

    bool HasFacet()
    {
        foreach ( var facet in _facets.Values )
        {
            if ( !string.IsNullOrEmpty( facet ) )
                return true;
        }

        return false;
    }

    // Each share's filters: its own, and the #tags of its description
    IEnumerable<string> FacetsOf( SharedLibrary<T>.Entry entry )
    {
        foreach ( var facet in Facets?.Invoke( entry.Item ) ?? Enumerable.Empty<string>() )
            yield return facet;

        foreach ( var word in (entry.Description ?? "").Split( ' ' ) )
        {
            if ( word.Length > 1 && word[ 0 ] == '#' )
                yield return $"{TagGroup}: {word.ToLowerInvariant()}";
        }
    }

    // The groups of filters the shares listed have, each with its values, in the order first found
    List<KeyValuePair<string, List<string>>> FacetGroups()
    {
        var groups = new List<KeyValuePair<string, List<string>>>();
        if ( Facets is null )
            return groups;

        foreach ( var entry in _entries )
        {
            foreach ( var facet in FacetsOf( entry ) )
            {
                var split = facet.IndexOf( ": " );
                if ( split < 0 )
                    continue;

                var key = facet[ ..split ];
                var at = -1;
                for ( var i = 0; i < groups.Count && at < 0; i++ )
                {
                    if ( groups[ i ].Key == key )
                        at = i;
                }

                if ( at < 0 )
                {
                    groups.Add( new( key, new List<string>() ) );
                    at = groups.Count - 1;
                }

                if ( !groups[ at ].Value.Contains( facet ) )
                    groups[ at ].Value.Add( facet );
            }
        }

        return groups;
    }

    static List<UIDropdown.Item> FacetChoices( KeyValuePair<string, List<string>> group )
    {
        var choices = new List<UIDropdown.Item> { new( $"{group.Key}: any", "" ) };
        foreach ( var facet in group.Value )
            choices.Add( new UIDropdown.Item( facet, facet ) );

        return choices;
    }

    void SetFacet( string group, string facet )
    {
        _facets[ group ] = facet ?? "";
        _page = 0;
        Arrange();
        Redraw();
    }

    bool Matches( SharedLibrary<T>.Entry entry )
    {
        foreach ( var facet in _facets.Values )
        {
            if ( !string.IsNullOrEmpty( facet ) && !FacetsOf( entry ).Contains( facet ) )
                return false;
        }

        var search = _search.Trim();
        return search == "" || $"{entry.Name} {entry.Description} {AuthorOf( entry )} {Describe?.Invoke( entry.Item )}".Contains( search, StringComparison.OrdinalIgnoreCase );
    }

    void SetBlocked( SharedLibrary<T>.Entry entry, bool blocked )
    {
        Block?.Invoke( entry, blocked );
        _status = blocked ? $"\"{NameOf( entry )}\" and every copy of it are hidden on your server. Unblock it here or on the Server page."
            : $"\"{NameOf( entry )}\" shows on your server again.";
        Redraw();
    }

    // The one listed that is just like this player's now, if any: that isn't published a second time
    SharedLibrary<T>.Entry Same
    {
        get
        {
            foreach ( var entry in Current is null ? new() : _entries )
            {
                if ( Library.Same( entry.Item, Current ) )
                    return entry;
            }

            return null;
        }
    }

    bool CanShare => Current is not null && !_busy && Same is null && !AtLimit && SharePost.TooBig( Library.PostOf( Current, Noun, "" ).Serialize() ) is null;

    // Why Share mine is off, when it is for something the player can do about
    string ShareNote
    {
        get
        {
            if ( Same is { } same )
            {
                return same.IsMine ? $"You've published this {Noun} already. Change it to publish a new one."
                    : $"This {Noun} is shared already, by {AuthorOf( same )}. Rate theirs in the Workshop instead.";
            }

            if ( Current is not null && SharePost.TooBig( Library.PostOf( Current, Noun, "" ).Serialize() ) is { } tooBig )
                return tooBig;

            return AtLimit ? $"You've published {Library.PerPlayer} {Noun}s{Scope}, the most at once. Take one down in the Workshop first." : null;
        }
    }

    // The authors' names are part of it: they come from Steam as they are now, and players change them
    protected override int BuildHash() => HashCode.Combine( ModelId, Current, Workshop, _revision, _status, _loading, _busy,
        HashCode.Combine( _page, _perPage, NamesHash(), _search ) );

    int Pages => Math.Max( 1, (_shown.Count + _perPage - 1) / _perPage );

    IEnumerable<SharedLibrary<T>.Entry> PageOfEntries => _shown.Skip( _page * _perPage ).Take( _perPage );

    // A player's own are never hidden from them
    bool IsHidden( SharedLibrary<T>.Entry entry ) => !entry.IsMine && _hidden.Contains( entry.Author );

    int HiddenCount => _entries.Count( IsHidden );

    // The hidden players are read again each time: hiding one in the other Workshop (looks, armatures) counts here too
    void Arrange()
    {
        _hidden = LocalPrefs.HiddenAuthors();
        var kept = new List<SharedLibrary<T>.Entry>();
        foreach ( var entry in _entries )
        {
            if ( (_showHidden || !IsHidden( entry )) && Matches( entry ) && Shows?.Invoke( entry.Item ) != false )
                kept.Add( entry );
        }

        _shown = _newest ? kept.OrderByDescending( ChangedOf ).ToList() : kept;
        _page = Math.Clamp( _page, 0, Pages - 1 );
    }

    static DateTimeOffset ChangedOf( SharedLibrary<T>.Entry entry ) => entry.Changed;

    void SortByTop() => SortBy( false );

    void SortByNew() => SortBy( true );

    void GoBack() => Back?.Invoke();

    void SortBy( bool newest )
    {
        _newest = newest;
        LocalPrefs.SharesByNewest = newest;
        _page = 0;
        Arrange();
        Redraw();
    }

    void ToggleShowHidden()
    {
        _showHidden = !_showHidden;
        Arrange();
        Redraw();
    }

    // Hiding closes the details, as the list they go back to no longer has it
    void ToggleHidden( SharedLibrary<T>.Entry entry )
    {
        var hide = !IsHidden( entry );
        LocalPrefs.SetHidden( entry.Author, hide );
        _status = hide ? $"{AuthorOf( entry )}'s shares are hidden, on your screen only. Show them under the list to unhide them."
            : $"{AuthorOf( entry )}'s shares show again.";

        if ( hide && !_showHidden )
            _details = null;

        Arrange();
        Redraw();
    }

    // The markup's handlers, each for the entry it is drawn for (see Bind)
    static SharedLibrary<T>.Entry EntryOf( object entry ) => (SharedLibrary<T>.Entry)entry;

    void VoteUp( object entry ) => _ = VoteAsync( EntryOf( entry ), 1 );

    void VoteDown( object entry ) => _ = VoteAsync( EntryOf( entry ), -1 );

    void UseOne( object entry ) => UseShared( EntryOf( entry ) );

    void ForkOne( object entry ) => Fork?.Invoke( EntryOf( entry ) );

    void TakeDown( object entry ) => _ = TakeDownAsync( EntryOf( entry ) );

    void ToggleHiddenOf( object entry ) => ToggleHidden( EntryOf( entry ) );

    void ToggleBlocked( object entry ) => SetBlocked( EntryOf( entry ), IsBlocked?.Invoke( EntryOf( entry ) ) != true );

    void Detail( object entry ) => ShowDetails( EntryOf( entry ) );

    // A row's right-click menu: what its buttons and its details do (Block for the host alone)
    void RowMenu( object argument )
    {
        var entry = EntryOf( argument );
        var entries = new List<ContextMenu.Entry> { new( "Use", "add_circle", Bind.Click( UseOne, entry ), "Use" ) };
        if ( Fork is not null )
            entries.Add( new( "Fork", "call_split", Bind.Click( ForkOne, entry ), "Fork" ) );

        entries.Add( new( "Details", "info", Bind.Click( Detail, entry ), "info" ) );
        if ( !entry.IsMine )
            entries.Add( new( IsHidden( entry ) ? "Unhide author" : "Hide author", "person_off", Bind.Click( ToggleHiddenOf, entry ) ) );

        if ( Block is not null && !entry.IsMine )
            entries.Add( new( IsBlocked?.Invoke( entry ) == true ? "Unblock on this server" : "Block on this server", "block", Bind.Click( ToggleBlocked, entry ) ) );

        ContextMenu.OpenFrom( this, NameOf( entry ), entries );
    }

    // Past the last page, while the Workshop has more than was read, the next of it is read first (see LoadMoreAsync)
    void ShowPage( int page )
    {
        if ( page >= Pages && MoreToRead )
        {
            _ = LoadMoreAsync( page );
            return;
        }

        _page = Math.Clamp( page, 0, Pages - 1 );
        Redraw();
    }

    // How many rows the list's room holds, checked every frame (the pane changes size with the window): a few divisions
    public override void Tick()
    {
        base.Tick();

        LimitShareBoxes();

        if ( _unresponsive && !_loading && !_busy && _sinceFailed > RetrySeconds )
        {
            _sinceFailed = 0f;
            _ = ListAsync();
        }

        if ( !Workshop || _list is null || !_list.IsValid() || ScaleToScreen <= 0f )
            return;

        var fits = Math.Max( 1, (int)(_list.Box.Rect.Height / ((Pictures ? PicturedRowHeight : RowHeight) * ScaleToScreen)) );
        if ( fits == _perPage )
            return;

        _perPage = fits;
        _page = Math.Clamp( _page, 0, Pages - 1 );
        Redraw();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if ( ModelId == _listedFor )
            return;

        _listedFor = ModelId;
        _status = null;
        _code = null;
        _details = null;
        _ = ListAsync();
    }

    async Task ListAsync()
    {
        var model = ModelId;
        _entries = new();
        _shown = new();
        _page = 0;
        _listed = false;
        _loading = !string.IsNullOrEmpty( model ) && Library is not null;
        Redraw();

        if ( !_loading )
            return;

        try
        {
            var entries = await Library.ListAsync( model );
            if ( model != ModelId )
                return;

            _entries = entries;
            Arrange();
            _listed = true;
            _unresponsive = false;

            // The details show the entry as listed now: its votes, its name if its author changed it
            if ( _details is not null )
                _details = Listed( _details.Id ) ?? _details;
        }
        catch ( Exception e )
        {
            Failed( e );
        }
        finally
        {
            if ( model == ModelId )
                _loading = false;

            Redraw();
        }
    }

    SharedLibrary<T>.Entry Listed( long id )
    {
        foreach ( var entry in _entries )
        {
            if ( entry.Id == id )
                return entry;
        }

        return null;
    }

    // Asks what to call it and what to say about it, then publishes it
    /// <summary>Opens the share window for <see cref="Current"/>, as Share mine does (a menu's Publish).</summary>
    public void Share() => OpenShare();

    void OpenShare()
    {
        if ( !CanShare )
            return;

        _shareModal = ShareWindow.Show( this, Noun, Publish );
        _shareLimited = false;
    }

    void Publish( string name, string description ) => _ = ShareAsync( name, description );

    // The share window's boxes hold no more than a name and description keep (the sheet doesn't take a length)
    void LimitShareBoxes()
    {
        if ( _shareLimited || !_shareModal.IsValid() )
            return;

        var boxes = 0;
        foreach ( var box in _shareModal.Descendants )
        {
            if ( box is not TextEntry entry )
                continue;

            entry.MaxLength = boxes == 0 ? SharePost.MaxNameLength : SharePost.MaxDescriptionLength;
            boxes++;
        }

        _shareLimited = boxes >= 2;
    }

    async Task ShareAsync( string name, string description )
    {
        if ( !CanShare )
            return;

        BeginBusy();
        try
        {
            var same = await Library.ShareAsync( Current, name, description );
            _status = same is null
                ? $"Published as \"{SharePost.Tidy( name, SharePost.MaxNameLength )}\". It stays as it is now; publish again to share changes."
                : same.IsMine ? $"You've published this {Noun} already."
                : $"{AuthorOf( same )} shared this {Noun} already. Rate theirs in the Workshop instead.";
            await ListAsync();
        }
        catch ( Exception e )
        {
            Failed( e );
        }
        finally
        {
            EndBusy();
        }
    }

    async Task TakeDownAsync( SharedLibrary<T>.Entry entry )
    {
        BeginBusy();
        try
        {
            await Library.UnshareAsync( entry.Id, ModelId );
            _details = null;
            _status = $"\"{NameOf( entry )}\" is taken down.";
            await ListAsync();
        }
        catch ( Exception e )
        {
            Failed( e );
        }
        finally
        {
            EndBusy();
        }
    }

    void ShowDetails( SharedLibrary<T>.Entry entry )
    {
        _details = entry;
        _more = null;
        _status = null;
        Redraw();
        _ = ListMoreAsync( entry );
    }

    void CloseDetails()
    {
        _details = null;
        _status = null;
        Redraw();
    }

    async Task ListMoreAsync( SharedLibrary<T>.Entry entry )
    {
        List<AuthorIndex.Share> more;
        try
        {
            more = await AuthorIndex.ListAsync( entry.Author );
        }
        catch ( Exception e )
        {
            Failed( e );
            more = new();
        }

        if ( _details?.Id != entry.Id )
            return;

        _more = more;
        Redraw();
    }

    // What else the author of what's open shared
    IEnumerable<AuthorIndex.Share> OthersOf( SharedLibrary<T>.Entry entry )
    {
        var key = AuthorIndex.KeyOf( Library.Kind, entry.Id );
        foreach ( var share in _more ?? new() )
        {
            if ( share.Key != key )
                yield return share;
        }
    }

    // Clicking the vote already given takes it back
    async Task VoteAsync( SharedLibrary<T>.Entry entry, int vote )
    {
        if ( entry.IsMine )
            return;

        BeginBusy();
        try
        {
            await Library.VoteAsync( entry.Id, Library.VoteOn( entry.Id ) == vote ? 0 : vote );
            await ListAsync();
        }
        catch ( Exception e )
        {
            Failed( e );
        }
        finally
        {
            EndBusy();
        }
    }

    void UseShared( SharedLibrary<T>.Entry entry )
    {
        if ( UseEntry is not null )
        {
            _status = UseEntry( entry );
            Redraw();
            return;
        }

        Took( entry.Item, entry.IsMine ? $"your {Noun}" : $"{AuthorOf( entry )}'s {Noun}" );
    }

    // The Workshop's sentence about itself: its first line at its top, the whole of it in that line's tooltip
    string IntroText => Intro ?? $"{Capitalised( Noun )}s players shared{Scope}: Top lists the best rated first, New the newest. Use one to put it on the preview; Apply wears it.";

    static string FirstLine( string text )
    {
        var end = text.IndexOfAny( new[] { '.', ':', ';' } );
        return end > 0 ? text[ ..end ] + "." : text;
    }

    void CopyCode()
    {
        if ( Current is null )
            return;

        Clipboard.SetText( ShareCode.Write( Noun, Library.Serialize( Current ) ) );
        _status = $"Code copied. Paste it anywhere to pass this {Noun} on.";
        Redraw();
    }

    void UseCode()
    {
        var item = Library.Parse( ShareCode.Read( Noun, _code ) );
        if ( item is null )
            _status = $"That isn't {A( Noun )} code.";
        else if ( Library.ModelOf( item ) != ModelId )
            _status = $"That code is for another model: {Library.ModelOf( item )}.";
        else
        {
            _code = null;
            Took( item, "the code" );
            return;
        }

        Redraw();
    }

    void Took( T item, string from )
    {
        _status = Use?.Invoke( item, from );
        Redraw();
    }

    // Around a change on its way: the buttons that would start another are off meanwhile
    void BeginBusy()
    {
        _busy = true;
        Redraw();
    }

    void EndBusy()
    {
        _busy = false;
        Redraw();
    }

    void Failed( Exception e )
    {
        Log.Warning( $"Player Model Selector: shared {Noun}s for '{ModelId}' failed: {e.Message}" );
        _unresponsive = Shared.IsUnresponsive( e );
        _status = _unresponsive ? null : Shared.Why( e );
        _sinceFailed = 0f;
    }

    void Redraw()
    {
        _revision++;
        StateHasChanged();
    }

    // The author as Steam names them now (players rename themselves); "A player" until Steam says
    static string AuthorOf( SharedLibrary<T>.Entry entry ) => AuthorIndex.NameOf( entry.Author );

    // The names of the authors shown, to draw again when Steam learns or changes one. Every frame: no allocations
    int NamesHash()
    {
        var hash = _details is null ? 0 : new Friend( _details.Author ).Name?.GetHashCode() ?? 0;
        var end = Math.Min( _shown.Count, (_page + 1) * _perPage );
        for ( var i = _page * _perPage; i < end; i++ )
            hash = HashCode.Combine( hash, new Friend( _shown[ i ].Author ).Name );

        return hash;
    }

    static string NameOf( SharedLibrary<T>.Entry entry ) => NameOf( entry.Name );

    static string NameOf( string name ) => string.IsNullOrEmpty( name ) ? "Untitled" : name;

    // A model as people know it: an sbox.game package by its name, a file by its own
    static string ModelName( string model )
    {
        if ( model.Contains( '/' ) )
            return System.IO.Path.GetFileNameWithoutExtension( model );

        var dot = model.IndexOf( '.' );
        return dot >= 0 ? model[ (dot + 1).. ] : model;
    }

    static string Capitalised( string text ) => string.IsNullOrEmpty( text ) ? "" : char.ToUpperInvariant( text[ 0 ] ) + text[ 1.. ];

    static string A( string noun ) => "aeiou".Contains( char.ToLowerInvariant( noun[ 0 ] ) ) ? $"an {noun}" : $"a {noun}";

    // Plain ifs: a line starting with "<" (a relational pattern) is read by Razor as markup
    static string Ago( DateTimeOffset when )
    {
        var days = (int)(DateTimeOffset.UtcNow - when).TotalDays;
        if ( days == 0 )
            return "today";

        if ( days == 1 )
            return "yesterday";

        return days >= 60 ? $"{days / 30} months ago" : $"{days} days ago";
    }

    // A vote button: lit for the vote this player gave, off for their own or while a change is on its way
    string VoteClass( SharedLibrary<T>.Entry entry, int way )
    {
        var lit = Library.VoteOn( entry.Id ) == way ? (way > 0 ? "up" : "down") : "";
        return entry.IsMine || _busy ? $"{lit} disabled" : lit;
    }

    // Added since the first version of this panel, so last: hot reload finds the closures and async methods above by their
    // place in it

    // Paging past what was read (see ShowPage): the next shares read (see SharedLibrary.MoreAsync) and ranked with those
    // listed, then the page asked for shown, or the last there is
    bool _loadingMore;

    bool MoreToRead => _listed && !string.IsNullOrEmpty( ModelId ) && Library?.HasMore( ModelId ) == true;

    // Top and New rank what was read so far: until all of it is, say so
    string SortTip( bool newest ) => (newest ? "The newest first" : "The best rated first") + (MoreToRead ? ", of those read so far: paging past the last page reads more" : "");

    async Task LoadMoreAsync( int page )
    {
        var model = ModelId;
        if ( _loadingMore || string.IsNullOrEmpty( model ) || Library is null )
            return;

        _loadingMore = true;
        Redraw();
        try
        {
            var entries = await Library.MoreAsync( model );
            if ( model != ModelId )
                return;

            _entries = entries;
            Arrange();
            _page = Math.Clamp( page, 0, Pages - 1 );
        }
        catch ( Exception e )
        {
            Failed( e );
        }
        finally
        {
            _loadingMore = false;
            Redraw();
        }
    }
}

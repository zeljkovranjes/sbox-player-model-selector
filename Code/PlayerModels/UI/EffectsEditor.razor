    void StartRename( object what, string name )
    {
        _renaming = what;
        _newName = name;
        StateHasChanged();
    }

    void CancelRename()
    {
        _renaming = null;
        StateHasChanged();
    }

    void Rename()
    {
        var name = _newName?.Trim();
        if ( string.IsNullOrEmpty( name ) )
            return;

        if ( _renaming is Draft draft )
            PlayerModels.Engine.Drafts.Rename( Draft.Of.Effect, draft.Id, name );
        else if ( _renaming is Effect kept )
        {
            var renamed = kept.Sanitized();
            renamed.Name = name;
            if ( LocalPrefs.SaveMyEffect( renamed ) )
                LocalPrefs.DeleteMyEffect( kept.Name );
        }

        _status = $"Renamed to \"{name}\".";
        _renaming = null;
        _mine = null;
        _mineRevision++;
        StateHasChanged();
    }

    void DuplicateKept( Effect kept )
    {
        var copy = kept.Sanitized();
        copy.Name = SharePost.Tidy( $"{kept.Name} copy", Effect.MaxNameLength );
        _status = LocalPrefs.SaveMyEffect( copy ) ? $"Copied as \"{copy.Name}\"." : $"My effects is full ({LocalPrefs.MaxMyEffects}). Delete one first.";
        _mine = null;
        _mineRevision++;
        StateHasChanged();
    }

    void DuplicateDraft( Draft draft )
    {
        var copy = PlayerModels.Engine.Drafts.Make( Draft.Of.Effect, null, SharePost.Tidy( $"{draft.Name} copy", Draft.MaxNameLength ), draft.Item, draft.State );
        _status = PlayerModels.Engine.Drafts.Save( copy, false, out _ ) ? $"Copied as the draft \"{copy.Name}\"." : $"Drafts are full ({Draft.MaxPerKind}). Delete one first.";
        StateHasChanged();

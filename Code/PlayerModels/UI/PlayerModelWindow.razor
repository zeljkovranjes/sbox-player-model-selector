@using System
@using System.Linq
@using Sandbox
@using Sandbox.UI
@inherits Panel
@namespace PlayerModels.UI

<root class="@( _open ? "" : "collapsed" )" @onmousedown=@WindowPress>

    <div class="title" @ref="TitleBar">Player Model Selector</div>

    <div class="body">
        <PlayerModelPage />
    </div>

</root>

@code
{
    const string OpenCookie = "player_model_selector.open";

    // The window's own heading on the bar along the top of the C menu, after Sandbox's
    const string HeadingTitle = "Player Model";

    // Space between the bar and the window under it
    const float Gap = 4f;

    bool _open = Game.Cookies.Get( OpenCookie, false );
    Menu _heading;
    Panel TitleBar = default;

    // Where the title bar was grabbed, in the window's pixels; null while it isn't held
    Vector2? _grab;

    // Where the window was dragged to, in the menu's pixels; null until it is, keeping it under its heading
    Vector2? _dropped;

    /// <summary>Puts the window and its heading in the C menu of this scene, unless they're there already.</summary>
    public static void AddTo( Scene scene )
    {
        var menu = FindContextMenu( scene );
        if ( menu is null )
            return;

        var window = menu.ChildrenOfType<PlayerModelWindow>().FirstOrDefault() ?? menu.AddChild<PlayerModelWindow>();
        window.AddHeading();
    }

    /// <summary>Takes the window and its heading out of the C menu of this scene.</summary>
    public static void RemoveFrom( Scene scene )
    {
        var menu = FindContextMenu( scene );
        if ( menu is null )
            return;

        foreach ( var window in menu.ChildrenOfType<PlayerModelWindow>().ToArray() )
            window.Delete( true );
    }

    // Sandbox's inspect menu, the one C opens
    static ContextMenuHost FindContextMenu( Scene scene )
    {
        var host = scene?.Get<SpawnMenuHost>();
        return host?.Panel?.Descendants.OfType<ContextMenuHost>().FirstOrDefault();
    }

    // Sandbox builds its bar before a selector can be spawned, and again after a hotload, so the heading is added to
    // whichever bar is there instead of through IMenuBarEvent
    void AddHeading()
    {
        if ( _heading.IsValid() )
            return;

        var bar = Parent?.Descendants.OfType<MenuBar>().FirstOrDefault();
        if ( bar is null )
            return;

        // A heading with no options opens nothing; a click on it opens and closes the window instead
        _heading = bar.AddMenu( HeadingTitle );
        _heading.AddEventListener( "onclick", Toggle );
        _heading.SetClass( "open", _open );
    }

    public override void OnDeleted()
    {
        base.OnDeleted();

        _heading?.Delete( true );
    }

    public override void Tick()
    {
        base.Tick();

        if ( !_open )
            return;

        Drag();
        Place();
    }

    protected override int BuildHash() => HashCode.Combine( _open );

    void Toggle()
    {
        _open = !_open;
        Game.Cookies.Set( OpenCookie, _open );
        _heading?.SetClass( "open", _open );
        StateHasChanged();
    }

    // Keep clicks on the window from selecting whatever is in the world behind it
    void WindowPress( PanelEvent e )
    {
        InputFocus.Clear();
        e.StopPropagation();
    }

    // While the title bar is held, the window follows the mouse. Not a panel drag: those never start under a press the
    // window keeps from the world.
    void Drag()
    {
        if ( !TitleBar.IsValid() || !TitleBar.HasActive )
        {
            _grab = null;
            return;
        }

        _grab ??= MousePosition;
        _dropped = Parent.MousePosition - _grab.Value;
    }

    // Under its heading until dragged, and always below the bar and on screen, so the title bar can be grabbed again
    void Place()
    {
        if ( !_heading.IsValid() || _heading.Box.Rect.Width <= 0 )
            return;

        var menu = Parent.Box.Rect;
        var heading = _heading.Box.Rect;
        var top = heading.Bottom - menu.Top + Gap * ScaleToScreen;
        var position = _dropped ?? new Vector2( heading.Left - menu.Left, top );
        var room = menu.Size - Box.Rect.Size;

        Style.Left = Length.Pixels( Math.Clamp( position.x, 0, Math.Max( room.x, 0 ) ) * ScaleFromScreen );
        Style.Top = Length.Pixels( Math.Clamp( position.y, top, Math.Max( room.y, top ) ) * ScaleFromScreen );
    }
}

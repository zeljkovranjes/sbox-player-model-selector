    // The variation takes the selected effect's place, keeping its id, name, key and whether it is on
    void UseVariation( Effect effect, Effect variation )
    {
        var index = Look.Effects.IndexOf( effect );
        if ( index < 0 )
            return;

        // Its drawn shapes are the look's already: a variation changes how they show, not what they are
        var used = EffectPresets.Copy( variation, Array.Empty<Effect>() );
        used.Shapes = null;
        used.Id = effect.Id;
        used.Key = effect.Key;
        used.Off = effect.Off;
        Look.Effects[ index ] = used;
        HideVariations();
        Changed?.Invoke();
    }


    // A copy of the preset (or of one kept in My effects), selected for its sliders
    void Add( Effect preset )
    {
        if ( IsFull )
            return;

        var effect = EffectPresets.Copy( preset, Look.Effects );
        if ( !Look.Adopt( effect ) )
        {
            _status = $"A look carries up to {DrawnShape.MaxPerLook} drawn shapes, and this would take it past that. Remove an effect with drawn shapes first.";
            StateHasChanged();
            return;
        }

        _selected = effect.Id;
        _status = null;
        Changed?.Invoke();
    }

    // An effect from scratch: worn, selected, and opened in the Advanced editor to build
    void AddNew()
    {
        if ( IsFull || LayersWorn() >= Effect.MaxLookLayers )
            return;

        var effect = EffectPresets.New( Look.Effects );
        Look.Effects.Add( effect );
        _selected = effect.Id;
        _status = null;
        Changed?.Invoke();
        OpenAdvanced?.Invoke( effect.Id );
    }

    // A surprise from the parts of the presets and My effects, within what the server's budget has left
    void AddSurprise()
    {
        if ( IsFull )
            return;

        var sources = EffectPresets.All.Concat( Mine ).ToList();
        var surprise = EffectRemix.Surprise( new Random(), sources, Look.Effects, Budget );
        if ( surprise is null )
        {
            _status = "There's no room left in this server's budget for a surprise. Remove or switch off an effect first.";
            StateHasChanged();
            return;
        }

        surprise.Id = Effect.NewId( Look.Effects );
        Look.Effects.Add( surprise );
        _selected = surprise.Id;
        _status = null;
        Changed?.Invoke();
    }

    // Keeps the selected effect in My effects, under the name typed (its own name when none is)
    void Keep( Effect effect )
    {
        var name = string.IsNullOrWhiteSpace( _keepName ) ? effect.Name : _keepName.Trim();
        var kept = Look.Standalone( effect ) ?? effect;
        kept.Name = name;
        _status = LocalPrefs.SaveMyEffect( kept ) ? $"Saved to My effects as \"{kept.Sanitized()?.Name}\"."
            : string.IsNullOrWhiteSpace( name ) ? "Give it a name first." : $"My effects is full ({LocalPrefs.MaxMyEffects}). Delete one first.";
        _keepName = null;
        _mine = null;
        _mineRevision++;
        StateHasChanged();
    }

    void Forget( Effect kept, PanelEvent e )
    {
        e.StopPropagation();
        LocalPrefs.DeleteMyEffect( kept.Name );
        _status = $"\"{kept.Name}\" is deleted from My effects.";
        _mine = null;
        _mineRevision++;
        StateHasChanged();
    }

    static string KeptTooltip( Effect kept ) => $"{kept.Layers.Count} {(kept.Layers.Count == 1 ? "layer" : "layers")}: click to put it on";


@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using PlayerModels.Components
@using PlayerModels.Core
@using PlayerModels.Engine
@inherits Panel
@namespace PlayerModels.UI

<root class="@( Workshop && !_guides ? "workshop" : "" )">
    @if ( _guides )
    {
        <EffectGuides Back=@(() => ShowGuides( false ))></EffectGuides>
    }
    else
    {
        <div class="workshop-tabs">
            <div class="workshop-tab @( _category == Category.Effects ? "active" : "" )" @onclick=@(() => ShowCategory( Category.Effects ))>Effects</div>
            <div class="workshop-tab @( _category == Category.Shapes ? "active" : "" )" @onclick=@(() => ShowCategory( Category.Shapes ))>Shapes</div>
            <div class="workshop-tab @( _category == Category.Stickers ? "active" : "" )" @onclick=@(() => ShowCategory( Category.Stickers ))>Stickers</div>
        </div>
    }
    @if ( _guides )
    {
    }
    else if ( Workshop && Look is not null )
    {
        @if ( _category == Category.Shapes )
        {
            <SharingPanel T="DrawnShape" Library=@Shared.Shapes Noun="shape" ModelId=@Shared.Everyone Scope=@Everywhere Workshop=@true Pictures=@true Searchable=@true
                          Intro="Shapes players made, for sprites to come from or look like: Top lists the best rated first, New the newest. Use one to keep it in My shapes; Fork opens it in the creator."
                          Shows=@IsShape UseEntry=@UseSharedShape Fork=@ForkShape ForkTip="Open a copy of it in the creator, to change and publish as your own"
                          OriginOf=@(( DrawnShape x ) => x.ForkedFrom) Block=@BlockShape IsBlocked=@IsShapeBlocked Describe=@ShapeCreator.DescribeShape
                          Back=@(() => ShowWorkshop?.Invoke( false ))></SharingPanel>
        }
        else if ( _category == Category.Stickers )
        {
            <SharingPanel T="DrawnShape" Library=@Shared.Shapes Noun="shape" ModelId=@Shared.Everyone Scope=@Everywhere Workshop=@true Pictures=@true Searchable=@true
                          Intro="Stickers players made, for sprites and weapons: Top lists the best rated first, New the newest. Use one to keep it in My stickers; Fork opens it in the creator."
                          Shows=@IsSticker Facets=@StickerFacets UseEntry=@UseSharedShape Fork=@ForkShape ForkTip="Open a copy of it in the creator, to change and publish as your own"
                          OriginOf=@(( DrawnShape x ) => x.ForkedFrom) Block=@BlockShape IsBlocked=@IsShapeBlocked Describe=@ShapeCreator.DescribeShape
                          Back=@(() => ShowWorkshop?.Invoke( false ))></SharingPanel>
        }
        else
        {
            <SharingPanel T="Effect" Library=@Shared.Effects Noun="effect" ModelId=@Shared.Everyone Scope=@Everywhere Workshop=@true Pictures=@true Searchable=@true
                          Intro="Effects and single layers players shared: Top lists the best rated first, New the newest. Use one to wear a copy (a layer joins the effect you selected); Fork opens a copy in the Advanced editor."
                          Facets=@EffectFacets UseEntry=@UseSharedEffect Fork=@ForkEffect ForkTip="Open a copy of it in the Advanced editor, to change and publish as your own"
                          OriginOf=@(( Effect x ) => x.ForkedFrom) Block=@BlockEffect IsBlocked=@IsEffectBlocked Describe=@DescribeEffect
                          Back=@(() => ShowWorkshop?.Invoke( false ))></SharingPanel>
        }
    }
    else if ( Look is null )
    {
        <div class="note">Loading your look...</div>
    }
    else if ( _category == Category.Shapes )
    {
        <div class="top">
            <div class="intro">Shapes sprites come from or look like: the standard ones, and yours to draw, write and erase. Click one to change it in the creator.</div>
            <div class="reset" Tooltip="Shapes players shared" @onclick=@(() => ShowWorkshop?.Invoke( true ))>Workshop</div>
        </div>
        <div class="section-header">My Shapes</div>
        <div class="grid">
            <div class="tile effect new" Tooltip="A shape of your own, in the creator" @onclick=@(() => OpenCreator?.Invoke( null, false, null ))>
                <div class="thumb new-icon">add</div>
                <div class="title">New shape</div>
            </div>
            @for ( var i = 0; i < FillersFor( 1 ); i++ )
            {
                <div class="tile-filler"></div>
            }
        </div>
        <ShapeShelf Stickers=@false Open=@OpenShape OpenDraft=@OpenShapeDraft Empty="Shapes you save, use from the Workshop or fork show here; drafts too, marked with a pencil."></ShapeShelf>
        <div class="section-header">Standard Shapes</div>
        <div class="grid">
            @foreach ( var standard in Enum.GetValues<StandardShape>() )
            {
                var shown = standard;
                <div class="tile effect" Tooltip="Open it in the creator, to make a shape of your own from it" @onclick=@(() => OpenStandard( shown ))>
                    <StandardShapeIcon class="thumb" Shape=@shown></StandardShapeIcon>
                    <div class="title">@ShapeName( shown )</div>
                </div>
            }
            @for ( var i = 0; i < FillersFor( Enum.GetValues<StandardShape>().Length ); i++ )
            {
                <div class="tile-filler"></div>
            }
        </div>
    }
    else if ( _category == Category.Stickers )
    {
        <div class="top">
            <div class="intro">Stickers are layers of shapes, text and drawings in colors of their own, for sprites and weapons. Click one to change it in the creator.</div>
            <div class="reset" Tooltip="Stickers players shared" @onclick=@(() => ShowWorkshop?.Invoke( true ))>Workshop</div>
        </div>
        <div class="section-header">My Stickers</div>
        <div class="grid">
            <div class="tile effect new" Tooltip="A sticker of your own, in the creator" @onclick=@(() => OpenCreator?.Invoke( null, true, null ))>
                <div class="thumb new-icon">add</div>
                <div class="title">New sticker</div>
            </div>
            @for ( var i = 0; i < FillersFor( 1 ); i++ )
            {
                <div class="tile-filler"></div>
            }
        </div>
        <ShapeShelf Stickers=@true Open=@OpenShape OpenDraft=@OpenShapeDraft Empty="Stickers you save, use from the Workshop or fork show here; drafts too, marked with a pencil."></ShapeShelf>
    }
    else
    {
        <div class="top">
            <div class="intro">Click an effect to put it on: the preview shows it, and Apply wears it.</div>
            <div class="tool @( History?.CanUndo == true ? "" : "disabled" )" Tooltip="Undo the last change to your effects" @onclick=@(() => Undo?.Invoke())>undo</div>
            <div class="tool @( History?.CanRedo == true ? "" : "disabled" )" Tooltip="Redo" @onclick=@(() => Redo?.Invoke())>redo</div>
            <div class="reset" Tooltip="What each part of an effect is, and how to do the harder things" @onclick=@(() => ShowGuides( true ))>Guides</div>
            <div class="reset" Tooltip="Effects players shared" @onclick=@(() => ShowWorkshop?.Invoke( true ))>Workshop</div>
            <div class="reset @( Selected is null ? "disabled" : "" )" Tooltip=@( Selected is null ? "Select an effect you wear first" : "Every layer of it, placed by hand" )
                 @onclick=@(() => OpenAdvanced?.Invoke( Selected?.Id ))>Edit in Advanced editor</div>
        </div>

        @if ( Locked )
        {
            <div class="note">The host keeps effects off on this server, so nobody sees yours. They stay with your look and come back when the host turns them on.</div>
        }
        else if ( Muted )
        {
            <div class="note">The host muted your effects on this server, so nobody sees them. They stay with your look and come back when the host unmutes you.</div>
        }

        <div class="section-header">Effects</div>
        <div class="grid">
            <div class="tile effect new @( IsFull ? "disabled" : "" )" Tooltip="An effect of your own, built layer by layer in the Advanced editor" @onclick=@AddNew>
                <div class="thumb new-icon">add</div>
                <div class="title">New effect</div>
            </div>
            @foreach ( var preset in EffectPresets.All )
            {
                var shown = preset;
                <div class="tile effect @( IsFull ? "disabled" : "" )" @onclick=@(() => Add( shown ))>
                    <EffectIcon class="thumb" Effect=@shown></EffectIcon>
                    <div class="title">@shown.Name</div>
                </div>
            }
            <div class="tile effect surprise @( IsFull ? "disabled" : "" )" Tooltip="A new effect from parts of the others, within this server's budget" @onclick=@AddSurprise>
                <div class="thumb surprise-icon">casino</div>
                <div class="title">Surprise me</div>
            </div>
            @for ( var i = 0; i < FillersFor( EffectPresets.All.Count + 2 ); i++ )
            {
                <div class="tile-filler"></div>
            }
        </div>
        @if ( IsFull )
        {
            <div class="note">You wear as many effects as a look can (@Effect.MaxWorn). Remove one to put on another.</div>
        }

        <div class="section-header">My Effects</div>
        @if ( Mine.Count == 0 && MyDrafts.Count == 0 )
        {
            <div class="note">Effects you keep show here, to put on again; drafts too, marked with a pencil. Select one you wear and save it below its sliders.</div>
        }
        else
        {
            <div class="grid">
                @foreach ( var kept in MyDrafts )
                {
                    var shown = kept;
                    <div class="tile effect draft" Tooltip=@( $"Draft: {shown.Name}, {shown.EditedText( PlayerModels.Engine.Drafts.Now )}. Click to go on with it in the Advanced editor" )
                         @onclick=@(() => OpenDraft( shown )) @onrightclick=@(() => DraftMenu( shown ))>
                        <EffectIcon class="thumb" Effect=@DraftEffect( shown )></EffectIcon>
                        <div class="title">@shown.Name</div>
                        <div class="badge" Tooltip="Draft">edit</div>
                        <div class="more" Tooltip="More: open, rename, duplicate, delete (or right-click)" @onclick=@(( PanelEvent e ) => Act( e, () => DraftMenu( shown ) ))>more_vert</div>
                    </div>
                }
                @foreach ( var kept in Mine )
                {
                    var shown = kept;
                    <div class="tile effect @( IsFull ? "disabled" : "" )" Tooltip=@KeptTooltip( shown ) @onclick=@(() => Add( shown )) @onrightclick=@(() => KeptMenu( shown ))>
                        <EffectIcon class="thumb" Effect=@shown></EffectIcon>
                        <div class="title">@shown.Name</div>
                        <div class="more" Tooltip="More: open, rename, duplicate, delete, publish, copy code (or right-click)" @onclick=@(( PanelEvent e ) => Act( e, () => KeptMenu( shown ) ))>more_vert</div>
                        <div class="forget" Tooltip="Delete from My effects" @onclick=@(( PanelEvent e ) => Forget( shown, e ))>delete</div>
                    </div>
                }
                @for ( var i = 0; i < FillersFor( Mine.Count + MyDrafts.Count ); i++ )
                {
                    <div class="tile-filler"></div>
                }
            </div>
        }
        @if ( _renaming is not null )
        {
            <div class="row">
                <div class="label">Rename to</div>
                <TextEntry class="key-entry" MaxLength=@Effect.MaxNameLength Value:bind=@_newName @onsubmit=@Rename></TextEntry>
                <div class="reset @( string.IsNullOrWhiteSpace( _newName ) ? "disabled" : "" )" @onclick=@Rename>Rename</div>
                <div class="reset" @onclick=@CancelRename>Cancel</div>
            </div>
        }
        @if ( _confirmDrop is { } oldest && Selected is { } dropFor )
        {
            <div class="row">
                <div class="note">@DropText( oldest )</div>
                <div class="reset" @onclick=@(() => KeepDraft( dropFor, true ))>Drop it</div>
                <div class="reset" @onclick=@CancelDrop>Cancel</div>
            </div>
        }
        @if ( _status is not null )
        {
            <div class="note status">@_status</div>
        }

        @if ( Look.Effects.Count > 0 )
        {
            <div class="section-header">Wearing</div>
            var held = Budget.HeldBack( Look.Effects );
            @for ( var i = 0; i < Look.Effects.Count; i++ )
            {
                var effect = Look.Effects[ i ];
                var waiting = held[ i ].Count( x => x );
                <div class="row worn @( effect.Id == _selected ? "selected" : "" ) @( waiting > 0 ? "over" : "" )"
                     Tooltip=@WaitingText( effect, waiting ) @onclick=@(() => Select( effect )) @onrightclick=@(() => WornMenu( effect ))>
                    <div class="switch @( effect.Off ? "" : "on" )" Tooltip=@( effect.Off ? "Turn on" : "Turn off" )
                         @onclick=@(( PanelEvent e ) => Toggle( effect, e ))>check</div>
                    @if ( IsDraft( effect ) )
                    {
                        <div class="badge" Tooltip="Draft: shown here, not worn until you finish it in the Advanced editor">edit</div>
                    }
                    <div class="worn-name">@effect.Name</div>
                    @if ( HiddenWhy( effect ) is { } why )
                    {
                        <div class="over-note" Tooltip=@why>Hidden on this server</div>
                    }
                    else if ( waiting > 0 )
                    {
                        <div class="over-note">Over this server's budget</div>
                    }
                    <div class="icon-button @( IsFull ? "disabled" : "" )" Tooltip="Duplicate" @onclick=@(( PanelEvent e ) => Act( e, () => Duplicate( effect ) ))>content_copy</div>
                    <div class="icon-button" Tooltip="More: edit, duplicate, save, save draft, remove (or right-click)" @onclick=@(( PanelEvent e ) => Act( e, () => WornMenu( effect ) ))>more_vert</div>
                    <div class="icon-button" Tooltip="Remove" @onclick=@(( PanelEvent e ) => Remove( effect, e ))>delete</div>
                </div>
            }
            <div class="note">@BudgetText()</div>
        }

        @if ( Selected is { } selected )
        {
            <div class="section-header">@selected.Name</div>
            @if ( selected.ForkedFrom is { } origin )
            {
                <div class="note">@ShapeCreator.BasedOn( origin )</div>
            }
            @if ( HiddenWhy( selected ) is { } hidden )
            {
                <div class="note">@hidden</div>
            }
            <SliderRow Label="Color" Value=@selected.Hue OnChanged=@(( float value ) => Set( () => selected.Hue = value ))></SliderRow>
            <SliderRow Label="Size" Signed=@true Value=@selected.Size OnChanged=@(( float value ) => Set( () => selected.Size = value ))></SliderRow>
            <SliderRow Label="Amount" Signed=@true Value=@selected.Amount OnChanged=@(( float value ) => Set( () => selected.Amount = value ))></SliderRow>
            <SliderRow Label="Speed" Signed=@true Value=@selected.Speed OnChanged=@(( float value ) => Set( () => selected.Speed = value ))></SliderRow>
            <div class="row">
                <div class="reset @( IsAsMade( selected ) ? "disabled" : "" )" @onclick=@(() => ResetSliders( selected ))>Reset sliders</div>
                <div class="reset @( IsDraft( selected ) ? "disabled" : "" )" Tooltip=@( IsDraft( selected ) ? "Not for a draft: finish it first" : "A few changed copies of it to pick from" ) @onclick=@(() => ShowVariations( selected ))>Variations</div>
            </div>
            @if ( _variations is { } variations && _variationsOf == selected.Id )
            {
                <div class="grid variations">
                    @for ( var i = 0; i < variations.Count; i++ )
                    {
                        var picked = variations[ i ];
                        <div class="tile effect" Tooltip="Use this one in place of it" @onclick=@(() => UseVariation( selected, picked ))>
                            <EffectIcon class="thumb" Effect=@picked></EffectIcon>
                            <div class="title">@( $"Variation {i + 1}" )</div>
                        </div>
                    }
                    @for ( var i = 0; i < FillersFor( variations.Count ); i++ )
                    {
                        <div class="tile-filler"></div>
                    }
                </div>
                <div class="row">
                    <div class="reset" @onclick=@(() => ShowVariations( selected ))>More like it</div>
                    <div class="reset" @onclick=@HideVariations>Close</div>
                </div>
            }

            <div class="row">
                <div class="label">Keep it</div>
                <TextEntry class="key-entry" Placeholder=@( string.IsNullOrEmpty( selected.Name ) ? "Its name" : selected.Name ) MaxLength=@Effect.MaxNameLength
                           Value:bind=@_keepName @onsubmit=@(() => Keep( selected ))></TextEntry>
                <div class="reset @( Mine.Count >= LocalPrefs.MaxMyEffects ? "disabled" : "" )" @onclick=@(() => Keep( selected ))>Save to My effects</div>
                <div class="reset" Tooltip="Keep it unfinished, to come back to: it shows, and isn't worn until you finish it" @onclick=@(() => KeepDraft( selected, false ))>Save draft</div>
            </div>
            @if ( IsDraft( selected ) )
            {
                <div class="note">A draft isn't worn, shared or published until you finish it: open it in the Advanced editor and press Finish.</div>
            }
            else
            {
                <SharingPanel @ref="_sharing" T="Effect" Library=@Shared.Effects Noun="effect" ModelId=@Shared.Everyone Scope=@Everywhere Current=@Shareable( selected )
                              ShareLabel="Share this effect" Describe=@DescribeEffect Workshop=@false></SharingPanel>
            }

            <div class="row">
                <div class="label">Key</div>
                <TextEntry class="key-entry" Placeholder="None, always shows" Value:bind=@KeyText AutoComplete=@KeysMatching></TextEntry>
                <KeyGlyph class="key-glyph" Key=@selected.Key></KeyGlyph>
                <div class="reset @( selected.Key is null ? "disabled" : "" )" @onclick=@(() => SetKey( selected, null ))>Clear</div>
            </div>
            <div class="note">@KeyNote( selected )</div>

            @if ( CycleOf( selected ) is { } cycle )
            {
                var mode = cycle.ColorModeIs;
                var colours = cycle.CycleColours();
                <div class="subheading">@ModeName( mode ) colors</div>
                @for ( var i = 0; i < colours.Count; i++ )
                {
                    var index = i;
                    <ColorRow Label=@ColourLabel( mode, index ) Hex=@colours[ index ] OnChanged=@(( string hex ) => SetCycleColour( selected, index, hex ))
                              ResetLabel=@( mode == LayerColorMode.Cyln ? "Reset" : "Remove" ) CanReset=@( mode == LayerColorMode.Cyln || colours.Count > 1 )></ColorRow>
                }
                <div class="row">
                    @if ( mode != LayerColorMode.Cyln )
                    {
                        <div class="reset @( colours.Count < EffectLayer.MaxPalette ? "" : "disabled" )" @onclick=@(() => AddCycleColour( selected ))>Add color</div>
                    }
                    <div class="reset @( cycle.Palette is null ? "disabled" : "" )" @onclick=@(() => UseCycleColours( selected, null ))>Game colors</div>
                </div>
            }
        }
    }

    @if ( Selector is { } selector && !_guides && !Workshop && _category == Category.Effects )
    {
        <div class="section-header">What You See</div>
        <div class="setting">
            <div class="label">Effects quality</div>
            <UIDropdown Items=@Qualities() Value=@selector.EffectsQuality ValueChanged=@SetQuality Tokenize=@false></UIDropdown>
        </div>
        @foreach ( var player in Others() )
        {
            var connection = player;
            <ToggleRow Label=@( $"Hide {connection.DisplayName}'s effects" ) Value=@selector.HidesEffectsOf( connection )
                       OnChanged=@(( bool hidden ) => Hide( connection, hidden ))></ToggleRow>
        }
        <div class="note">Only on your screen, and never more than the host allows. Lower quality shows fewer sprites and lights on everyone, you too.</div>
    }
</root>

@code
{
    /// <summary>The look being edited. Changed in place; <see cref="Changed"/> says when.</summary>
    [Parameter] public PlayerLook Look { get; set; }

    /// <summary>Called after every change to <see cref="Look"/>.</summary>
    [Parameter] public Action Changed { get; set; }

    /// <summary>Whether the host keeps this player's effects off: they are kept, and can still be changed.</summary>
    [Parameter] public bool Locked { get; set; }

    /// <summary>Opens the Advanced editor on the effect given, by id.</summary>
    [Parameter] public Action<string> OpenAdvanced { get; set; }

    /// <summary>Whether the Workshop shows (effects, shapes and stickers players shared) in place of the effects.</summary>
    [Parameter] public bool Workshop { get; set; }

    /// <summary>Opens the Workshop (true) or goes back to the effects (false); the page decides, as its pane fits the Workshop.</summary>
    [Parameter] public Action<bool> ShowWorkshop { get; set; }

    /// <summary>
    /// Opens the Advanced editor's creator: on the shape given (one of the player's, a fork from the Workshop) or the
    /// draft, or on a new sticker (true) or shape.
    /// </summary>
    [Parameter] public Action<DrawnShape, bool, Draft> OpenCreator { get; set; }

    /// <summary>The drafts open in the editors (the page's): an effect that is one is shown, not worn until finished.</summary>
    [Parameter] public OpenDrafts DraftsOpen { get; set; }

    /// <summary>The steps back and forward through changes to the effects, and what takes them.</summary>
    [Parameter] public EditHistory History { get; set; }
    [Parameter] public Action Undo { get; set; }
    [Parameter] public Action Redo { get; set; }

    static PlayerModelSelector Selector => PlayerModelSelector.Find( Game.ActiveScene );

    // Five tiles to a row like the Models grid, the last row made up with fillers so its tiles keep their width
    const int TilesPerRow = 5;

    static int FillersFor( int tiles ) => (TilesPerRow - tiles % TilesPerRow) % TilesPerRow;

    // The worn effect the sliders change, by id
    string _selected;

    // Whether the guides show in place of the effects
    bool _guides;

    void ShowGuides( bool show )
    {
        _guides = show;
        StateHasChanged();
    }

    Effect Selected => Look?.Effects.FirstOrDefault( x => x.Id == _selected );

    bool IsFull => Look.Effects.Count >= Effect.MaxWorn;

    // The look as text, as last drawn: what the panel is drawn again for
    string _lookText;

    protected override int BuildHash() => HashCode.Combine( _lookText = Look?.Serialize(), _selected, _guides, Locked, Selector?.EffectsBudget, Selector?.EffectsQuality,
        string.Join( ";", Others().Select( x => $"{x.Id}{Selector?.HidesEffectsOf( x )}" ) ),
        HashCode.Combine( (int)(Selector?.TriggerWait() ?? 0f), History?.CanUndo, History?.CanRedo, _mineRevision, _status, _variationsOf, _variations,
            HashCode.Combine( Workshop, _category, Muted, Selector?.BlockWorkshopEffects, Selector?.BlockDrawnShapes, Selector?.BlockEffectLights, Selector?.BlockedShares?.Count,
                HashCode.Combine( DraftsOpen?.Revision, PlayerModels.Engine.Drafts.Revision, _renaming, _confirmDrop ) ) ) );

    public override void Tick()
    {
        base.Tick();

        // Publish, from a tile's menu, opens the share window once the effect it put on is the one selected
        if ( _publishNext && _sharing is not null && _sharing.IsValid() && Selected is not null )
        {
            _publishNext = false;
            _sharing.Share();
        }
    }

    // Effects and shapes are shared for everyone, not for a model
    const string Everywhere = "";

    // Which category shows, on the tab and in its Workshop alike: effects, shapes or stickers
    enum Category { Effects, Shapes, Stickers }

    Category _category;

    void ShowCategory( Category category )
    {
        _category = category;
        StateHasChanged();
    }

    static bool IsShape( DrawnShape shape ) => !shape.IsSticker;

    static bool IsSticker( DrawnShape shape ) => shape.IsSticker;

    void OpenShape( DrawnShape shape ) => OpenCreator?.Invoke( shape, shape.IsSticker, null );

    void OpenShapeDraft( Draft draft ) => OpenCreator?.Invoke( null, ShapeShelf.ShapeOf( draft )?.IsSticker == true, draft );

    // A standard shape in the creator, its outlines as strokes, to make one of the player's own from
    void OpenStandard( StandardShape shape )
    {
        var (closed, open) = StandardShapes.Outline( shape );
        var strokes = closed.Select( x => new ShapeStroke { Closed = true, Points = x } ).Concat( open.Select( x => new ShapeStroke { Points = x } ) );
        OpenCreator?.Invoke( DrawnShape.From( strokes, ShapeName( shape ) ), false, null );
    }

    // "RightTriangle" as "Right triangle", "Star5" as "5-point star"
    static string ShapeName( StandardShape shape )
    {
        var name = shape.ToString();
        if ( name.StartsWith( "Star" ) )
            return $"{name[ 4.. ]}-point star";

        return shape == StandardShape.SineWave ? "Sine wave" : string.Concat( name.Select( ( c, i ) => i > 0 && char.IsUpper( c ) ? $" {char.ToLowerInvariant( c )}" : c.ToString() ) );
    }

    static bool IsHost => Networking.IsHost;

    // Whether the host muted this player's effects
    static bool Muted => !IsHost && Selector?.IsEffectsMuted( Connection.Local ) == true;

    // Why the host keeps an effect worn from showing (or showing whole) to others, in plain words; null when it shows
    static string HiddenWhy( Effect effect )
    {
        if ( IsHost || Selector is not { } selector )
            return null;

        if ( effect.ForkedFrom is { } origin && selector.IsShareBlocked( origin.Key ) )
            return "The host blocked the Workshop share this is based on, so nobody here sees it. It stays with your look.";

        if ( effect.ForkedFrom is not null && selector.BlockWorkshopEffects )
            return "The host keeps effects from the Workshop off here, so nobody sees this one. It stays with your look.";

        if ( selector.BlockDrawnShapes && effect.Layers.Any( x => x.DrawnFormation is not null || x.DrawnPicture is not null ) )
            return "The host keeps drawn shapes off here: others see a plain circle or glow in their place.";

        return selector.BlockEffectLights && effect.Lights() > 0 ? "The host keeps effects' lights off here: others see it without them." : null;
    }

    // The selected effect as it would be shared, carrying its drawn shapes: made again only when the look changes
    Effect _shareable;
    string _shareableFor;

    Effect Shareable( Effect effect )
    {
        var key = effect.Id + _lookText;
        if ( key != _shareableFor )
        {
            _shareableFor = key;
            _shareable = Look.Standalone( effect );
        }

        return _shareable;
    }

    /// <summary>What a row says about an effect: how many layers, of what, and where it comes from.</summary>
    public static string DescribeEffect( Effect effect )
    {
        var kinds = effect.Layers.Select( x => x.KindIs ).Distinct().Select( x => x switch { LayerKind.Light => "light", LayerKind.Trail => "trail", _ => "sprites" } );
        var layers = effect.Layers.Count == 1 ? "One layer" : $"{effect.Layers.Count} layers";
        return $"{layers}: {string.Join( ", ", kinds )}, from the {AnchorWords( effect.Anchor )}";
    }

    static string AnchorWords( EffectAnchor anchor ) => anchor.KindIs switch
    {
        AnchorKind.Item => "item worn",
        AnchorKind.HeldWeapon => "weapon held",
        _ => anchor.Joint switch
        {
            nameof( Effect.Joint.LeftEye ) or nameof( Effect.Joint.RightEye ) or nameof( Effect.Joint.Eyes ) => "eyes",
            nameof( Effect.Joint.LeftHand ) or nameof( Effect.Joint.RightHand ) => "hands",
            nameof( Effect.Joint.LeftFoot ) or nameof( Effect.Joint.RightFoot ) => "feet",
            nameof( Effect.Joint.Crown ) => "top of the head",
            _ => anchor.Joint.ToLowerInvariant(),
        },
    };

    // What an effect share is filtered by: where it comes from, whether it is a whole effect or one layer, what it has
    static IEnumerable<string> EffectFacets( Effect effect )
    {
        yield return $"Comes from: {AnchorWords( effect.Anchor )}";
        yield return effect.Layers.Count == 1 ? "Kind: single layer" : "Kind: whole effect";
        foreach ( var kind in effect.Layers.Select( x => x.KindIs ).Distinct() )
            yield return $"Has: {kind switch { LayerKind.Light => "a light", LayerKind.Trail => "a trail", _ => "sprites" }}";

        if ( effect.Shapes is { Count: > 0 } )
            yield return "Has: drawn shapes";
    }

    // What a sticker share is filtered by: how its colours move (its own, or its layers')
    static IEnumerable<string> StickerFacets( DrawnShape shape )
    {
        var motion = shape.Sticker?.AnimationIs ?? Sticker.Motion.None;
        foreach ( var layer in shape.Emblem ?? new List<EmblemLayer>() )
            motion = motion == Sticker.Motion.None ? layer.AnimationIs : motion;

        yield return motion == Sticker.Motion.None ? "Moves: no" : $"Moves: {motion.ToString().ToLowerInvariant()}";
        if ( shape.Emblem is { } layers )
            yield return layers.Count == 1 ? "Layers: one" : "Layers: several";
    }

    static ShareOrigin OriginOf<T>( SharedLibrary<T>.Entry entry, string kind ) => new() { Kind = kind, Id = entry.Id, Name = entry.Name, Author = entry.Author };

    // A copy of the share to wear, crediting it: a single layer joins the selected effect when it has room, anything else
    // is an effect of its own. Budget-checked like any effect put on
    string UseSharedEffect( SharedLibrary<Effect>.Entry entry )
    {
        var copy = EffectPresets.Copy( entry.Item, Look.Effects );
        copy.ForkedFrom = OriginOf( entry, ShareOrigin.EffectKind );
        copy.Name = string.IsNullOrEmpty( entry.Name ) ? copy.Name : SharePost.Tidy( entry.Name, Effect.MaxNameLength );
        var who = Whose( entry );

        if ( copy.Layers.Count == 1 && Selected is { } selected && selected.Layers.Count < Effect.MaxLayers && LayersWorn() < Effect.MaxLookLayers )
        {
            foreach ( var shape in copy.Shapes ?? new() )
            {
                if ( !Look.Carry( shape ) )
                    return $"A look carries up to {DrawnShape.MaxPerLook} drawn shapes, and this would take it past that.";
            }

            var layer = copy.Layers[ 0 ];
            layer.Joint ??= copy.Anchor.KindIs == AnchorKind.Joint && copy.Anchor.Joint != selected.Anchor.Joint ? copy.Anchor.Joint : null;
            selected.Layers.Add( layer );
            Changed?.Invoke();
            return $"Added {who} layer \"{entry.Name}\" to {selected.Name}. Apply wears it.";
        }

        if ( IsFull || LayersWorn() + copy.Layers.Count > Effect.MaxLookLayers )
            return $"You wear as many effects as a look can ({Effect.MaxWorn} effects, {Effect.MaxLookLayers} layers). Remove one first.";

        if ( !Look.Adopt( copy ) )
            return $"A look carries up to {DrawnShape.MaxPerLook} drawn shapes, and this would take it past that. Remove an effect with drawn shapes first.";

        _selected = copy.Id;
        Changed?.Invoke();
        return Budget.Fits( Look.Effects ) ? $"Put on {who} effect \"{entry.Name}\". Apply wears it."
            : $"Put on {who} effect \"{entry.Name}\", but it is over this server's budget: its last layers wait until you remove some.";
    }

    // "your", "Ana's", or "a player's" while Steam doesn't say whose
    static string Whose( SharedLibrary<Effect>.Entry entry )
    {
        var name = AuthorIndex.NameOf( entry.Author );
        return entry.IsMine ? "your" : name == "A player" ? "a player's" : $"{name}'s";
    }

    // A copy worn and opened in the Advanced editor, crediting the share
    void ForkEffect( SharedLibrary<Effect>.Entry entry )
    {
        if ( UseSharedEffectAsNew( entry ) is { } effect )
            OpenAdvanced?.Invoke( effect.Id );
    }

    Effect UseSharedEffectAsNew( SharedLibrary<Effect>.Entry entry )
    {
        var copy = EffectPresets.Copy( entry.Item, Look.Effects );
        copy.ForkedFrom = OriginOf( entry, ShareOrigin.EffectKind );
        copy.Name = string.IsNullOrEmpty( entry.Name ) ? copy.Name : SharePost.Tidy( entry.Name, Effect.MaxNameLength );
        if ( IsFull || !Look.Adopt( copy ) )
            return null;

        _selected = copy.Id;
        Changed?.Invoke();
        return copy;
    }

    int LayersWorn() => Look.Effects.Sum( x => x.Layers.Count );

    // A shape shared is used by keeping it in My shapes, crediting the share, to pick in a layer's lists
    string UseSharedShape( SharedLibrary<DrawnShape>.Entry entry )
    {
        var shape = Credited( entry );
        return LocalPrefs.SaveMyShape( shape ) ? $"\"{shape.Name}\" is in My shapes: pick it in a layer's Comes from or Looks like, in the Advanced editor."
            : $"My shapes is full ({LocalPrefs.MaxMyShapes}). Delete one in the shape creator first.";
    }

    void ForkShape( SharedLibrary<DrawnShape>.Entry entry )
    {
        var shape = Credited( entry );
        OpenCreator?.Invoke( shape, shape.IsSticker, null );
    }

    static DrawnShape Credited( SharedLibrary<DrawnShape>.Entry entry )
    {
        var name = string.IsNullOrWhiteSpace( entry.Name ) ? "Shape" : entry.Name;
        return entry.Item.Credited( name, OriginOf( entry, ShareOrigin.ShapeKind ) );
    }

    // The host blocks a share on their server from its details
    Action<SharedLibrary<Effect>.Entry, bool> BlockEffect => IsHost ? ( entry, blocked ) => Selector?.SetShareBlocked( ShareOrigin.KeyOf( ShareOrigin.EffectKind, entry.Id ), entry.Name, blocked ) : null;
    Action<SharedLibrary<DrawnShape>.Entry, bool> BlockShape => IsHost ? ( entry, blocked ) => Selector?.SetShareBlocked( ShareOrigin.KeyOf( ShareOrigin.ShapeKind, entry.Id ), entry.Name, blocked ) : null;

    static bool IsEffectBlocked( SharedLibrary<Effect>.Entry entry ) => Selector?.IsShareBlocked( ShareOrigin.KeyOf( ShareOrigin.EffectKind, entry.Id ) ) == true;
    static bool IsShapeBlocked( SharedLibrary<DrawnShape>.Entry entry ) => Selector?.IsShareBlocked( ShareOrigin.KeyOf( ShareOrigin.ShapeKind, entry.Id ) ) == true;


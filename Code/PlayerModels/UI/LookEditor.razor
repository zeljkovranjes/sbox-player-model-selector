@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Sandbox
@using Sandbox.UI
@using PlayerModels.Core
@using PlayerModels.Engine
@inherits Panel
@namespace PlayerModels.UI

<root class="@( Workshop ? "workshop" : "" )">
    @if ( Model is null || Look is null || Look.IsDefault )
    {
        <div class="note">Pick a model to customize it. The default citizen wears your avatar.</div>
    }
    else if ( Workshop )
    {
        <SharingPanel T="PlayerLook" Library=@Shared.Looks Noun="look" ModelId=@Look.Model Current=@CurrentLook
                      Use=@UseSharedLook Describe=@DescribeLook Workshop=@true Back=@(() => ShowWorkshop?.Invoke( false ))></SharingPanel>
    }
    else
    {
        @if ( Advanced && PartRows() >= FindFrom )
        {
            <div class="row find-row">
                <div class="find-icon">search</div>
                <TextEntry class="name-entry find" Placeholder="Find a part, group or morph" Value:bind=@_find></TextEntry>
            </div>
        }
        @if ( Advanced )
        {
            <FoldingSection Title="Styles" Key=@FoldKey( "Styles" ) Summary=@SavedSummary()>
                <Body>
                    <div class="row save-row">
                        <TextEntry class="name-entry" Placeholder=@NextStyleName() Value:bind=@_lookName @onsubmit=@SaveStyle></TextEntry>
                        <div class="button" @onclick=@SaveStyle>Save style</div>
                    </div>
                    @foreach ( var saved in SavedLooks() )
                    {
                        var name = saved.Name;
                        var editing = name == _style;
                        <div class="row saved-look @( editing ? "editing" : "" )">
                            <div class="saved-name">@name</div>
                            @if ( editing )
                            {
                                <div class="button @( StyleChanged( saved ) ? "" : "disabled" )" @onclick=@SaveStyleChanges>Save changes</div>
                            }
                            else
                            {
                                <div class="button" @onclick=@(() => SwitchStyle( name ))>Switch</div>
                            }
                            <div class="icon-button" Tooltip="Delete" @onclick=@(() => DeleteSavedLook( name ))>delete</div>
                        </div>
                    }
                </Body>
            </FoldingSection>
        }
        else if ( !Compact )
        {
            <div class="top">
                <div class="intro">Change how it looks; Apply wears it.</div>
                <div class="buttons">
                    <div class="tool @( Look.IsCustomised ? "" : "disabled" )" Tooltip="Reset everything" @onclick=@ResetAll>refresh</div>
                    <div class="tool workshop" Tooltip=@WorkshopTip @onclick=@(() => ShowWorkshop?.Invoke( true ))>
                        <div class="glyph">storefront</div>
                        @if ( WorkshopCount > 0 )
                        {
                            <div class="count">@WorkshopCount</div>
                        }
                    </div>
                    <div class="reset" Tooltip="Every option, with the model in the middle of the screen" @onclick=@(() => OpenAdvanced?.Invoke())><div class="glyph">tune</div>Advanced editor</div>
                </div>
            </div>

            <FoldingSection Title="Saved Looks" Key=@FoldKey( "Saved Looks" ) Folded=@true Summary=@SavedSummary()>
                <Body>
                    <div class="row save-row">
                        <TextEntry class="name-entry" Placeholder=@NextLookName() Value:bind=@_lookName @onsubmit=@SaveLook></TextEntry>
                        <div class="button" @onclick=@SaveLook>Save</div>
                    </div>
                    @foreach ( var saved in SavedLooks() )
                    {
                        var name = saved.Name;
                        <div class="row saved-look">
                            <div class="saved-name" @onclick=@(() => UseSavedLook( name ))>@name</div>
                            <div class="button" @onclick=@(() => UseSavedLook( name ))>Use</div>
                            <div class="icon-button" Tooltip="Delete" @onclick=@(() => DeleteSavedLook( name ))>delete</div>
                        </div>
                    }
                </Body>
            </FoldingSection>
        }

        <FoldingSection Title="Color" Key=@FoldKey( "Color" )>
            <Body>
                @if ( Skins() is { Count: > 1 } skins )
                {
                    <div class="row">
                        <div class="label">Skin</div>
                        <ScrollingDropdown Items=@skins Value=@( Look.Skin ?? "" ) ValueChanged=@SetSkin Tokenize=@false></ScrollingDropdown>
                    </div>
                }
                <ColorRow Label=@WholeLabel Hex=@Look.Tint OnChanged=@SetTint></ColorRow>
                @foreach ( var part in ColorParts().Where( Found ) )
                {
                    var name = part;
                    <ColorRow Label=@( name.Replace( '_', ' ' ) ) Hex=@PartColour( name ) OnChanged=@(( string hex ) => SetPartColour( name, hex ))
                              @onmouseenter=@(() => Point( PartHighlight.Part( name ) )) @onmouseleave=@(() => Point( null ))></ColorRow>
                }
            </Body>
        </FoldingSection>

        @if ( Advanced || Compact )
        {
            <FoldingSection Title="Finish" Key=@FoldKey( "Finish" )>
                <Body>
                    <div class="row">
                        <div class="label">@WholeLabel</div>
                        <ScrollingDropdown Items=@Finishes() Value=@( Look.Finish ?? "" ) ValueChanged=@SetFinish Tokenize=@false></ScrollingDropdown>
                    </div>
                    @foreach ( var part in FinishParts().Where( Found ) )
                    {
                        var name = part;
                        <div class="row" @onmouseenter=@(() => Point( PartHighlight.Part( name ) )) @onmouseleave=@(() => Point( null ))>
                            <div class="label">@( name.Replace( '_', ' ' ) )</div>
                            <ScrollingDropdown Items=@PartFinishChoices( name ) Value=@PartFinish( name ) ValueChanged=@(( object finish ) => SetPartFinish( name, finish )) Tokenize=@false></ScrollingDropdown>
                        </div>
                    }
                </Body>
            </FoldingSection>
        }

        @if ( !Compact )
        {
            <FoldingSection Title="Body Shape" Key=@FoldKey( "Body Shape" ) Folded=@( !Advanced ) Summary=@ShapeSummary()>
                <Body>
                    @foreach ( var part in Enum.GetValues<BodyShape.Part>() )
                    {
                        var shape = part;
                        <SliderRow Label=@ShapeLabel( shape ) Value=@ShapeOf( shape ) Signed=@true OnChanged=@(( float amount ) => SetShape( shape, amount ))></SliderRow>
                    }
                </Body>
            </FoldingSection>
        }

        @if ( BodyParts().Any() && BodyGroupsLocked )
        {
            <div class="section-header">Body Groups</div>
            <div class="note">The host keeps body groups off on this server, so your model shows its own. Your choices come back when they turn them on.</div>
        }
        else if ( BodyParts().Any() )
        {
            <FoldingSection Title="Body Groups" Key=@FoldKey( "Body Groups" ) Summary=@( Look.BodyGroups.Count > 0 ? $"{Look.BodyGroups.Count} changed" : "As made" )>
                <Body>
                    @foreach ( var part in BodyParts().Where( x => Found( x.Name ) ) )
                    {
                        var name = part.Name;
                        var current = ChoiceOf( name );
                        <div class="row" @onmouseenter=@(() => Point( PartHighlight.Group( name, current ) )) @onmouseleave=@(() => Point( null ))>
                            <div class="label">@( name.Replace( '_', ' ' ) )</div>
                            <div class="choices">
                                @foreach ( var choice in ChoicesOf( part ) )
                                {
                                    var index = choice.Index;
                                    <div class="choice @( choice.Index == current ? "active" : "" )" @onclick=@(() => Choose( name, index ))
                                         @onmouseenter=@(() => Point( PartHighlight.Group( name, index ) ))
                                         @onmouseleave=@(() => Point( PartHighlight.Group( name, ChoiceOf( name ) ) ))>@choice.Label</div>
                                }
                            </div>
                        </div>
                        @foreach ( var colour in ChoiceColours( part, current ) )
                        {
                            var material = colour;
                            <ColorRow Label=@( $"{name.Replace( '_', ' ' )} color" ) Hex=@PartColour( material ) OnChanged=@(( string hex ) => SetPartColour( material, hex ))></ColorRow>
                        }
                    }
                </Body>
            </FoldingSection>
        }

        @if ( MorphNames().Any() )
        {
            <FoldingSection Title="Morphs" Key=@FoldKey( "Morphs" ) Summary=@( Look.Morphs.Count > 0 ? $"{Look.Morphs.Count} set" : "As made" )>
                <Body>
                    @foreach ( var morph in MorphNames().Where( Found ) )
                    {
                        var name = morph;
                        <SliderRow Label=@name Value=@WeightOf( name ) OnChanged=@(( float weight ) => SetMorph( name, weight ))></SliderRow>
                    }
                </Body>
            </FoldingSection>
        }

        @if ( !Compact && !Advanced )
        {
            <SharingPanel T="PlayerLook" Library=@Shared.Looks Noun="look" ModelId=@Look.Model Current=@CurrentLook
                          Use=@UseSharedLook Describe=@DescribeLook Workshop=@false></SharingPanel>
        }
    }
</root>

@code
{
    /// <summary>The model being customised, loaded.</summary>
    [Parameter] public Model Model { get; set; }

    /// <summary>The look being edited. Changed in place; <see cref="Changed"/> says when.</summary>
    [Parameter] public PlayerLook Look { get; set; }

    /// <summary>Called after every change to <see cref="Look"/>.</summary>
    [Parameter] public Action Changed { get; set; }

    /// <summary>Called with the part under the mouse (a body group choice or a coloured part), null when it leaves.</summary>
    [Parameter] public Action<PartHighlight?> Pointed { get; set; }

    /// <summary>Whether the host keeps this player's body group choices off: they are kept, but not offered.</summary>
    [Parameter] public bool BodyGroupsLocked { get; set; }

    /// <summary>The Advanced editor's options: Styles and finishes as well, with sharing left to its own window.</summary>
    [Parameter] public bool Advanced { get; set; }

    /// <summary>Only what an item can have: colours, finish, body groups and morphs. <see cref="Look"/> is its style.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Opens the Advanced editor.</summary>
    [Parameter] public Action OpenAdvanced { get; set; }

    /// <summary>Whether the Workshop shows (the looks players shared for the model) in place of the options.</summary>
    [Parameter] public bool Workshop { get; set; }

    /// <summary>Opens the Workshop (true) or goes back to the options (false); the page decides, as its pane fits the Workshop.</summary>
    [Parameter] public Action<bool> ShowWorkshop { get; set; }

    void Point( PartHighlight? highlight ) => Pointed?.Invoke( highlight );

    // The look as it is shared or copied, without the armature; none when nothing is customised
    PlayerLook CurrentLook => Look.IsCustomised ? Look.Customisation() : null;

    long WorkshopCount => Shared.Looks.CountOf( Look.Model );

    string WorkshopTip => WorkshopCount > 0 ? $"Workshop: the {WorkshopCount} looks players shared for this model" : "Workshop: looks players shared for this model";

    // Where each group's folding is kept: the page, the Advanced editor and an item's options each keep their own
    string FoldKey( string group ) => $"{(Compact ? "Item" : Advanced ? "Advanced" : "Customize")}/{group}";

    // What a folded group holds, in a few words
    string SavedSummary() => SavedLooks().Count is > 0 and var saved ? $"{saved} saved" : "None yet";

    string ShapeSummary() => Look.Shape.Count > 0 ? $"{Look.Shape.Count} changed" : "As made";

    // A shared look in place of this one's customisation, on the preview until Apply; the armature stays
    string UseSharedLook( PlayerLook look, string from )
    {
        Look.TakeCustomisationFrom( look );
        Changed?.Invoke();
        StateHasChanged();
        return $"Put {from} on the preview. Press Apply to wear it.";
    }

    // What a shared look changes, in a few words: "a skin, colours and body shape"
    public static string DescribeLook( PlayerLook look )
    {
        var changes = new List<string>();
        if ( !string.IsNullOrEmpty( look.Skin ) ) changes.Add( "a skin" );
        if ( !string.IsNullOrEmpty( look.Tint ) || look.Parts.Count > 0 ) changes.Add( "colours" );
        if ( !string.IsNullOrEmpty( look.Finish ) || look.PartFinishes.Count > 0 ) changes.Add( "a finish" );
        if ( look.Accessories.Count > 0 ) changes.Add( "items" );
        if ( look.Effects.Count > 0 ) changes.Add( "effects" );
        if ( look.BodyGroups.Count > 0 ) changes.Add( "body groups" );
        if ( look.Morphs.Count > 0 ) changes.Add( "morphs" );
        if ( look.Shape.Count > 0 ) changes.Add( "body shape" );

        return changes.Count switch
        {
            0 => "nothing",
            1 => changes[ 0 ],
            _ => string.Join( ", ", changes.Take( changes.Count - 1 ) ) + " and " + changes[ ^1 ],
        };
    }

    // How many looks are shared for the model, asked once per model, for the Workshop button to say
    string _countedFor;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if ( Look is null || Look.Model == _countedFor )
            return;

        _countedFor = Look.Model;
        _style = null;

        if ( !Compact )
            _ = CountSharedAsync( Look.Model );
    }

    async Task CountSharedAsync( string model )
    {
        if ( string.IsNullOrEmpty( model ) )
            return;

        try
        {
            if ( await Shared.Looks.CountAsync( new[] { model } ) )
                StateHasChanged();
        }
        catch ( Exception e )
        {
            Log.Warning( $"Player Model Selector: couldn't count the looks shared for '{model}': {e.Message}" );
        }
    }

    // The name typed for the next saved look, and a count that redraws the list when one is saved or deleted
    string _lookName = "";
    int _savedRevision;

    protected override int BuildHash() => HashCode.Combine( Model, Look?.Serialize(), _savedRevision, Workshop, Shared.Looks.CountOf( Look?.Model ), _style, _find );

    // In the Advanced editor, a model with this many parts, groups and morphs gets a box to find one by name
    const int FindFrom = 12;
    string _find = "";

    int PartRows() => ColorParts().Count() + FinishParts().Count() + BodyParts().Count() + MorphNames().Count();

    // Whether a part, group or morph is listed: all of them until something is typed in the find box
    bool Found( string name ) => string.IsNullOrWhiteSpace( _find ) || name.Replace( '_', ' ' ).Contains( _find.Trim().Replace( '_', ' ' ), StringComparison.OrdinalIgnoreCase );

    string WholeLabel => Compact ? "Whole item" : "Whole model";

    // The model's skins, default first, each valued by its material group's name ("" for the default). A stock
    // character's skin is your avatar's skin tone, so it has none to choose
    List<UIDropdown.Item> Skins()
    {
        var skins = new List<UIDropdown.Item>();
        if ( Model is null || ModelOutfit.IsStock( Look.Model ) )
            return skins;

        for ( var i = 0; i < Model.MaterialGroupCount; i++ )
        {
            var name = Model.GetMaterialGroupName( i );
            skins.Add( i == 0 ? new UIDropdown.Item( "Default", "" ) : new UIDropdown.Item( ChoiceName( name ), name ) );
        }

        return skins;
    }

    void SetSkin( object skin )
    {
        Look.Skin = skin as string ?? "";
        Changed?.Invoke();
    }

    List<SavedLook> SavedLooks() => LocalPrefs.SavedLooks( Look.Model );

    string NextLookName() => $"Look {SavedLooks().Count + 1}";

    string NextStyleName() => $"Style {SavedLooks().Count + 1}";

    // Saves what the preview shows, under the typed name or the next free "Look N"
    void SaveLook()
    {
        var name = string.IsNullOrWhiteSpace( _lookName ) ? NextLookName() : _lookName.Trim();
        LocalPrefs.SaveLook( name, Look );
        _lookName = "";
        _savedRevision++;
        StateHasChanged();
    }

    // Puts a saved look on the preview; Apply wears it. The bones picked by hand stay: they belong to the model, not the look
    void UseSavedLook( string name )
    {
        var saved = SavedLooks().FirstOrDefault( x => x.Name == name );
        if ( saved is null )
            return;

        Look.TakeCustomisationFrom( PlayerLook.Parse( saved.Look ) );
        Changed?.Invoke();
        StateHasChanged();
    }

    void DeleteSavedLook( string name )
    {
        LocalPrefs.DeleteSavedLook( Look.Model, name );
        if ( name == _style )
            _style = null;

        _savedRevision++;
        StateHasChanged();
    }

    // The style being edited on the Advanced editor, of the looks saved for the model. What is published from it stays as
    // it was published: styles are this player's own, and only Share mine puts one in the Workshop
    string _style;

    bool StyleChanged( SavedLook saved ) => !PlayerLook.Parse( saved.Look ).SameCustomisationAs( Look );

    void SaveStyle()
    {
        var name = string.IsNullOrWhiteSpace( _lookName ) ? NextStyleName() : _lookName.Trim();
        LocalPrefs.SaveLook( name, Look );
        _style = name;
        _lookName = "";
        _savedRevision++;
        StateHasChanged();
    }

    // Puts the style on the preview for editing; Save changes keeps what was changed
    void SwitchStyle( string name )
    {
        _style = name;
        UseSavedLook( name );
    }

    void SaveStyleChanges()
    {
        if ( _style is null )
            return;

        LocalPrefs.SaveLook( _style, Look );
        _savedRevision++;
        StateHasChanged();
    }

    static List<UIDropdown.Item> FinishChoices( string none )
    {
        var choices = new List<UIDropdown.Item> { new( none, "" ) };
        choices.AddRange( MaterialFinish.All.Select( x => new UIDropdown.Item( x, x ) ) );
        return choices;
    }

    static List<UIDropdown.Item> Finishes() => FinishChoices( "Its own" );

    // A part can also be hidden (a dress that isn't a body group), but not the body, and not the last part showing
    List<UIDropdown.Item> PartFinishChoices( string part )
    {
        var choices = FinishChoices( "Same as whole" );
        var trial = new Dictionary<string, string>( Look.PartFinishes ) { [ part ] = MaterialFinish.Hidden };
        if ( Hiding.HiddenParts( PartTints.PartsOf( Model ), trial ).Contains( part ) )
            choices.Add( new UIDropdown.Item( MaterialFinish.Hidden, MaterialFinish.Hidden ) );

        return choices;
    }

    void SetFinish( object finish )
    {
        Look.Finish = finish as string ?? "";
        Changed?.Invoke();
    }

    // Each part can have its own: a finish replaces the material, so unlike a colour it goes on a mounted game's parts too.
    // A stock character's clothes are models of their own, so it only gets the whole-model finish on its body
    IEnumerable<string> FinishParts()
    {
        return Model is null || ModelOutfit.IsStock( Look.Model ) ? Enumerable.Empty<string>() : PartTints.PartsOf( Model );
    }

    string PartFinish( string part ) => Look.PartFinishes.TryGetValue( part, out var finish ) ? finish : "";

    void SetPartFinish( string part, object finish )
    {
        if ( finish is string name && name != "" )
            Look.PartFinishes[ part ] = name;
        else
            Look.PartFinishes.Remove( part );

        Changed?.Invoke();
    }

    // The model's materials, coloured one by one. A stock character takes its colours from your avatar and its clothes
    // are models of their own, and a mounted game's materials can't be copied, so both only get the whole-model tint
    IEnumerable<string> ColorParts()
    {
        if ( Model is null || ModelOutfit.IsStock( Look.Model ) || MountModels.IsMountPath( Look.Model ) )
            return Enumerable.Empty<string>();

        return PartTints.PartsOf( Model );
    }

    string PartColour( string part ) => Look.Parts.TryGetValue( part, out var hex ) ? hex : "";

    // The parts the body group's current choice draws, to colour right there. The same parts as ColorParts offers, so what
    // can't be coloured there isn't offered here
    IEnumerable<string> ChoiceColours( Model.BodyPart part, int choice )
    {
        if ( choice < 0 || choice >= part.Choices.Count || !ColorParts().Any() )
            return Enumerable.Empty<string>();

        return PartTints.PartsOfChoice( Model, part.Choices[ choice ].Mask );
    }

    // A button of a body group: a choice that shows something, the model's own default, or Hidden for an accessory. The
    // body itself is never offered hidden (LookPainter enforces the same for every look, on every client)
    record ChoiceButton( string Label, int Index );

    // Groups with at least two choices that show something
    IEnumerable<Model.BodyPart> BodyParts()
    {
        if ( Model is null )
            return Enumerable.Empty<Model.BodyPart>();

        return Model.Parts.All.Where( x => ChoicesOf( x ).Count > 1 );
    }

    static List<ChoiceButton> ChoicesOf( Model.BodyPart part )
    {
        var buttons = new List<ChoiceButton>();
        for ( var i = 0; i < part.Choices.Count; i++ )
        {
            if ( part.Choices[ i ].Mask != 0 )
                buttons.Add( new ChoiceButton( ChoiceName( part.Choices[ i ].Name ), i ) );
        }

        // Names that don't tell the choices apart (empty, or the same source file twice) become numbered options
        if ( buttons.Any( x => x.Label == "" ) || buttons.Select( x => x.Label ).Distinct().Count() < buttons.Count )
        {
            for ( var i = 0; i < buttons.Count; i++ )
                buttons[ i ] = buttons[ i ] with { Label = $"Option {i + 1}" };
        }

        // An accessory the model leaves off by default (a cape) can be put on and taken off again
        if ( part.Choices.Count > 0 && part.Choices[ 0 ].Mask == 0 )
        {
            buttons.Insert( 0, new ChoiceButton( "Default", 0 ) );
            return buttons;
        }

        // One the model shows by default (a hat, a weapon) can be hidden, through its first empty choice
        var empty = Enumerable.Range( 0, part.Choices.Count ).FirstOrDefault( i => part.Choices[ i ].Mask == 0, -1 );
        if ( empty > 0 && LookPainter.CanHide( part.Name ) )
            buttons.Add( new ChoiceButton( "Hidden", empty ) );

        return buttons;
    }

    // "../dmatch/lowcount/rgrunt/DMRGrunt_Template_Biped1.smd" -> "DMRGrunt Template Biped1": the name, not its folders
    static string ChoiceName( string name )
    {
        if ( string.IsNullOrWhiteSpace( name ) )
            return "";

        var start = name.LastIndexOfAny( new[] { '/', '\\' } ) + 1;
        var end = name.LastIndexOf( '.' );
        var file = end > start ? name[ start..end ] : name[ start.. ];

        return file.Replace( '_', ' ' ).Trim();
    }

    IEnumerable<string> MorphNames() => Model?.Morphs?.Names ?? Array.Empty<string>();

    int ChoiceOf( string group ) => Look.BodyGroups.TryGetValue( group, out var choice ) ? choice : 0;

    float WeightOf( string morph ) => Look.Morphs.TryGetValue( morph, out var weight ) ? weight : 0f;

    void Choose( string group, int choice )
    {
        if ( choice == 0 )
            Look.BodyGroups.Remove( group );
        else
            Look.BodyGroups[ group ] = choice;

        Changed?.Invoke();
    }

    void SetMorph( string morph, float weight )
    {
        if ( weight <= 0f )
            Look.Morphs.Remove( morph );
        else
            Look.Morphs[ morph ] = weight;

        Changed?.Invoke();
    }

    float ShapeOf( BodyShape.Part part ) => Look.Shape.TryGetValue( part.ToString(), out var amount ) ? amount : 0f;

    // "ArmLength" -> "Arm length"
    static string ShapeLabel( BodyShape.Part part )
    {
        var name = part.ToString();
        var label = new System.Text.StringBuilder( name.Length + 2 );
        for ( var i = 0; i < name.Length; i++ )
        {
            if ( i > 0 && char.IsUpper( name[ i ] ) )
                label.Append( ' ' ).Append( char.ToLowerInvariant( name[ i ] ) );
            else
                label.Append( name[ i ] );
        }

        return label.ToString();
    }

    void SetShape( BodyShape.Part part, float amount )
    {
        if ( MathF.Abs( amount ) < 0.005f )
            Look.Shape.Remove( part.ToString() );
        else
            Look.Shape[ part.ToString() ] = amount;

        Changed?.Invoke();
    }

    void SetTint( string hex )
    {
        Look.Tint = hex;
        Changed?.Invoke();
    }

    void SetPartColour( string part, string hex )
    {
        if ( string.IsNullOrEmpty( hex ) )
            Look.Parts.Remove( part );
        else
            Look.Parts[ part ] = hex;

        Changed?.Invoke();
    }

    void ResetAll()
    {
        Look.TakeCustomisationFrom( new PlayerLook() );
        Changed?.Invoke();
        StateHasChanged();
    }
}

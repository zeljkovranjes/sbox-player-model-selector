@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using PlayerModels.Core
@using PlayerModels.Core.Script
@using PlayerModels.Engine
@inherits Panel
@namespace PlayerModels.UI

<root>
    @if ( Parameters() is { Count: > 0 } parameters )
    {
        <div class="section-header">Parameters</div>
        @foreach ( var group in parameters.GroupBy( x => x.Group ?? "Options" ) )
        {
            <div class="group @( _folded.Contains( group.Key ) ? "folded" : "" )" @onclick=@(() => Fold( group.Key ))>
                <div class="fold-icon">@( _folded.Contains( group.Key ) ? "chevron_right" : "expand_more" )</div>
                <TextLabel class="group-name" Text=@group.Key></TextLabel>
            </div>
            @if ( !_folded.Contains( group.Key ) )
            {
                @foreach ( var parameter in group )
                {
                    var shown = parameter;
                    var value = ValueOf( shown );
                    <div class="parameter">
                        <div class="widget">
                            @switch ( shown.Kind )
                            {
                                case ParameterKind.Number or ParameterKind.Integer:
                                    <RangeRow Label=@shown.Title Tip=@shown.Tip Value=@Number( value ) Min=@RangeOf( shown ).Min Max=@RangeOf( shown ).Max Step=@StepOf( shown )
                                              OnChanged=@(( double v ) => Set( shown, v.ToString( "R", CultureInfo.InvariantCulture ) ))></RangeRow>
                                    break;
                                case ParameterKind.Bool:
                                    <ToggleRow Label=@shown.Title Value=@( value == "true" ) OnChanged=@(( bool v ) => Set( shown, v ? "true" : "false" ))></ToggleRow>
                                    break;
                                case ParameterKind.Color:
                                    <ColorRow Label=@shown.Title Hex=@Hex( value ) CanReset=@false OnChanged=@(( string hex ) => Set( shown, hex ))></ColorRow>
                                    break;
                                case ParameterKind.Palette:
                                    var colours = value.Split( ',' );
                                    <TextLabel class="widget-title" Text=@shown.Title Tooltip=@shown.Tip></TextLabel>
                                    @for ( var i = 0; i < colours.Length; i++ )
                                    {
                                        var index = i;
                                        <ColorRow Label=@( $"Color {index + 1}" ) Hex=@Hex( colours[ index ] ) ResetLabel="Remove" CanReset=@( colours.Length > 1 )
                                                  OnChanged=@(( string hex ) => SetColour( shown, colours, index, hex ))></ColorRow>
                                    }
                                    <div class="row">
                                        <div class="reset @( colours.Length < EffectLayer.MaxPalette ? "" : "disabled" )" @onclick=@(() => Set( shown, value + "," + colours[ ^1 ] ))>Add color</div>
                                    </div>
                                    break;
                                case ParameterKind.Vector3:
                                    var parts = Parts( value );
                                    @for ( var i = 0; i < 3; i++ )
                                    {
                                        var axis = i;
                                        <RangeRow Label=@( $"{shown.Title} {"XYZ"[ axis ]}" ) Tip=@shown.Tip Value=@parts[ axis ] Min=@RangeOf( shown ).Min Max=@RangeOf( shown ).Max Step=@StepOf( shown )
                                                  OnChanged=@(( double v ) => SetPart( shown, parts, axis, v ))></RangeRow>
                                    }
                                    break;
                                case ParameterKind.Key:
                                    <div class="row">
                                        <TextLabel class="label" Text=@shown.Title Tooltip=@shown.Tip></TextLabel>
                                        <ScrollingDropdown Items=@KeyChoices() Value=@value ValueChanged=@(( object v ) => Set( shown, (string)v )) Tokenize=@false></ScrollingDropdown>
                                        <KeyGlyph class="key-glyph" Key=@value></KeyGlyph>
                                    </div>
                                    break;
                                case ParameterKind.Shape or ParameterKind.Picture:
                                    <div class="row">
                                        <TextLabel class="label" Text=@shown.Title Tooltip=@shown.Tip></TextLabel>
                                        <ScrollingDropdown Items=@ShapeChoices( shown, value ) Value=@value ValueChanged=@(( object v ) => Set( shown, (string)v )) Tokenize=@false></ScrollingDropdown>
                                        @if ( OwnShape( value ) is { } own )
                                        {
                                            <ShapeIcon class="shape-picture" Shape=@own></ShapeIcon>
                                        }
                                    </div>
                                    break;
                                case ParameterKind.Choice:
                                    <div class="row">
                                        <TextLabel class="label" Text=@shown.Title Tooltip=@shown.Tip></TextLabel>
                                        <ScrollingDropdown Items=@ChoicesOf( shown ) Value=@value ValueChanged=@(( object v ) => Set( shown, (string)v )) Tokenize=@false></ScrollingDropdown>
                                    </div>
                                    break;
                                default:
                                    <div class="row">
                                        <TextLabel class="label" Text=@shown.Title Tooltip=@shown.Tip></TextLabel>
                                        <TextEntry class="text-entry" MaxLength=@ScriptLimits.MaxStringLength Value=@value
                                                   @onsubmit=@(( PanelEvent e ) => Set( shown, (e.Target as TextEntry)?.Text ?? "" ))></TextEntry>
                                    </div>
                                    break;
                            }
                        </div>
                        <div class="tool @( IsSet( shown ) ? "" : "disabled" )" Tooltip="Reset: back to the script's own value" @onclick=@(() => Reset( shown ))>refresh</div>
                        <div class="tool @( IsSet( shown ) ? "" : "disabled" )" Tooltip="Save as default: write this value into the script" @onclick=@(() => SaveAsDefault( shown ))>save</div>
                    </div>
                }
            }
        }
        @if ( _status is not null )
        {
            <TextLabel class="note" Text=@_status></TextLabel>
        }
    }
</root>

@code
{
    /// <summary>The look the effect is worn in (it carries the drawn shapes its script may name).</summary>
    [Parameter] public PlayerLook Look { get; set; }

    /// <summary>The effect whose script's parameters show; nothing shows for one without a script or parameters.</summary>
    [Parameter] public Effect Effect { get; set; }

    /// <summary>Called after every change (the preview follows).</summary>
    [Parameter] public Action Changed { get; set; }

    readonly HashSet<string> _folded = new();
    string _status;

    protected override int BuildHash() => HashCode.Combine( Effect?.Id, Effect?.Script, Effect?.Parameters is { } values ? string.Join( ";", values ) : "", string.Join( ";", _folded ), _status );

    // The script's parameters, in their order (by Order, then as written); none while it doesn't compile
    List<ScriptParameter> Parameters()
    {
        if ( Effect?.Script is not { } script )
            return null;

        var compiled = ScriptPrograms.Cache.Compile( script, ScriptKind.Effect, Library() );
        return compiled.Program?.Parameters.OrderBy( x => double.IsNaN( x.Order ) ? 0 : x.Order ).ToList();
    }

    string ValueOf( ScriptParameter parameter ) => Effect.Parameters is { } values && values.TryGetValue( parameter.Name, out var value ) ? value : parameter.Default ?? "";

    bool IsSet( ScriptParameter parameter ) => Effect.Parameters?.ContainsKey( parameter.Name ) == true;

    void Fold( string group )
    {
        if ( !_folded.Remove( group ) )
            _folded.Add( group );

        StateHasChanged();
    }

    // A value chosen: kept with the effect (the script itself isn't changed), and the effect built again with it
    void Set( ScriptParameter parameter, string value )
    {
        Effect.Parameters ??= new Dictionary<string, string>();
        Effect.Parameters[ parameter.Name ] = value ?? "";
        Rebuild();
    }

    void Reset( ScriptParameter parameter )
    {
        if ( Effect.Parameters?.Remove( parameter.Name ) != true )
            return;

        if ( Effect.Parameters.Count == 0 )
            Effect.Parameters = null;

        Rebuild();
    }

    // The value chosen written into the script's own literal (a colour in the form it was written), and the choice let go
    void SaveAsDefault( ScriptParameter parameter )
    {
        if ( !IsSet( parameter ) || Effect.Script is null )
            return;

        var source = Formatter.Format( Effect.Script ) ?? Effect.Script;
        var compiled = ScriptCompiler.Compile( source, ScriptKind.Effect, Library() );
        if ( !compiled.Succeeded )
            return;

        var edit = ScriptEdit.SaveAsDefault( source, compiled.Program, parameter.Name, ValueOf( parameter ) );
        if ( !edit.Succeeded )
        {
            _status = edit.Problem;
            StateHasChanged();
            return;
        }

        Effect.Script = Minifier.Minify( edit.Source );
        Effect.Parameters?.Remove( parameter.Name );
        if ( Effect.Parameters?.Count == 0 )
            Effect.Parameters = null;

        _status = $"{parameter.Title} is now the script's own";
        Rebuild();
    }

    // The effect built again from its script with the values chosen (each held to its parameter; stale ones dropped)
    void Rebuild()
    {
        var library = Library();
        var compiled = ScriptPrograms.Cache.Compile( Effect.Script, ScriptKind.Effect, library );
        if ( !compiled.Succeeded )
            return;

        var machine = new ScriptMachine( compiled.Program );
        var kept = machine.SetParameters( Effect.Parameters );
        var build = machine.Build( library, ScriptPrograms.Stack );
        if ( !build.Succeeded )
        {
            _status = build.Error?.ToString();
            StateHasChanged();
            return;
        }

        // The look carries the shapes the build drew (one of the player's own a parameter names among them), so
        // everyone sees them without having them
        foreach ( var shape in build.Effect.Shapes ?? new List<DrawnShape>() )
        {
            if ( Look?.Carry( shape ) == false )
                _status = $"A look carries at most {DrawnShape.MaxPerLook} drawn shapes: this one isn't kept";
        }

        ScriptSync.Adopt( Effect, build.Effect );
        Effect.Parameters = kept.Count > 0 ? kept : null;
        Effect.Shapes = null;
        Changed?.Invoke();
        StateHasChanged();
    }

    static double Number( string value ) => double.TryParse( value, NumberStyles.Float, CultureInfo.InvariantCulture, out var number ) ? number : 0;

    // A number's range: its own, or round its default
    static (double Min, double Max) RangeOf( ScriptParameter parameter )
    {
        if ( !double.IsNaN( parameter.Min ) && !double.IsNaN( parameter.Max ) )
            return (parameter.Min, parameter.Max);

        var made = parameter.Kind == ParameterKind.Vector3 ? Parts( parameter.Default ?? "0,0,0" ).Max( Math.Abs ) : Math.Abs( Number( parameter.Default ) );
        var reach = Math.Max( 1, made * 2 );
        return (parameter.Kind == ParameterKind.Vector3 || Number( parameter.Default ) < 0 ? -reach : 0, reach);
    }

    static double StepOf( ScriptParameter parameter ) => !double.IsNaN( parameter.Step ) ? parameter.Step : parameter.Kind == ParameterKind.Integer ? 1 : 0;

    static double[] Parts( string value )
    {
        var parts = (value ?? "").Split( ',' );
        var numbers = new double[ 3 ];
        for ( var i = 0; i < 3 && i < parts.Length; i++ )
            numbers[ i ] = Number( parts[ i ] );

        return numbers;
    }

    void SetPart( ScriptParameter parameter, double[] parts, int axis, double value )
    {
        var copy = parts.ToArray();
        copy[ axis ] = value;
        Set( parameter, string.Join( ",", copy.Select( x => x.ToString( "R", CultureInfo.InvariantCulture ) ) ) );
    }

    void SetColour( ScriptParameter parameter, string[] colours, int index, string hex )
    {
        var list = colours.ToList();
        if ( string.IsNullOrEmpty( hex ) )
            list.RemoveAt( index );
        else
            list[ index ] = hex;

        if ( list.Count > 0 )
            Set( parameter, string.Join( ",", list ) );
    }

    static string Hex( string value ) => value is { Length: >= 7 } && value[ 0 ] == '#' ? value[ ..7 ] : "#ffffff";

    static List<UIDropdown.Item> KeyChoices() => Effect.Keys.Select( x => new UIDropdown.Item( x.ToUpperInvariant(), x ) ).ToList();

    static List<UIDropdown.Item> ChoicesOf( ScriptParameter parameter ) =>
        (parameter.Choices ?? Array.Empty<string>()).Select( x => new UIDropdown.Item( x, x ) ).ToList();

    // What the script may name (the player's own, with the shapes the look carries), made once per change to what shows
    MyLibrary _library;
    int _libraryFor;

    MyLibrary Library()
    {
        var key = HashCode.Combine( Look, Look?.DrawnShapes.Count, LocalPrefs.MyShapesVersion );
        if ( _library is null || key != _libraryFor )
            (_library, _libraryFor) = (new MyLibrary( Look?.DrawnShapes ), key);

        return _library;
    }

    // A shape or picture parameter's choices: the stock ones, then the player's own shapes and stickers (My shapes, the
    // Workshop ones they used, those the look carries), and the one chosen even when it is gone from them
    List<UIDropdown.Item> ShapeChoices( ScriptParameter parameter, string value )
    {
        var stock = parameter.Kind == ParameterKind.Picture ? Enum.GetNames<LayerPicture>().Concat( Enum.GetNames<StandardShape>() ) : Enum.GetNames<StandardShape>();
        var items = stock.Select( x => new UIDropdown.Item( x, x ) ).ToList();
        foreach ( var shape in Library().Shapes )
        {
            var kind = LookLibrary.KindOf( shape );
            var text = ScriptParameter.OwnShapeText( kind, shape.Name );
            if ( !items.Exists( x => (string)x.Value == text ) )
                items.Add( new UIDropdown.Item( $"{(kind == LibraryItemKind.Sticker ? "My sticker" : "My shape")}: {shape.Name}", text ) );
        }

        if ( ScriptParameter.OwnShapeOf( value ) is { } chosen && !items.Exists( x => (string)x.Value == value ) )
            items.Add( new UIDropdown.Item( $"{chosen.Name} (not in My shapes)", value ) );

        return items;
    }

    // The player's own shape a value names, as the look carries it or My shapes has it; null for a stock one
    DrawnShape OwnShape( string value ) =>
        ScriptParameter.OwnShapeOf( value ) is { } own ? Library().Shape( own.Name, own.Kind ) : null;
}

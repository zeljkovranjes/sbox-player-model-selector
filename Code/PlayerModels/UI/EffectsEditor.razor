    // The selected effect's key as typed: a key's name puts it on, an empty box takes it off, anything else waits for more
    string KeyText
    {
        get => Selected?.Key ?? "";
        set
        {
            if ( Selected is not { } effect )
                return;

            var key = Effect.KeyNamed( value );
            if ( key is not null || string.IsNullOrWhiteSpace( value ) )
                SetKey( effect, key );
        }
    }

    static object[] KeysMatching( string typed )
    {
        var start = typed?.Trim() ?? "";
        return Effect.Keys.Where( x => x.StartsWith( start, StringComparison.OrdinalIgnoreCase ) ).Cast<object>().ToArray();
    }

    void SetKey( Effect effect, string key )
    {
        if ( effect.Key == key )
            return;

        effect.Key = key;
        Changed?.Invoke();
        StateHasChanged();
    }

    // What a key does, and how long until one works again
    string KeyNote( Effect effect )
    {
        var minutes = (int)(Effect.TriggerCooldownSeconds / 60f);
        if ( effect.Key is null )
            return $"Give it a key and it shows only when you press it, for {Effect.TriggerSeconds:0} seconds. Effect keys work once every {minutes} minutes.";

        var wait = Selector?.TriggerWait() ?? 0f;
        var ready = wait > 0f ? $" Your next one in {(int)wait / 60}:{(int)wait % 60:00}." : "";
        return $"Press {effect.Key.ToUpperInvariant()} and it shows for {Effect.TriggerSeconds:0} seconds, for everyone. Effect keys work once every {minutes} minutes, whichever effect they are for.{ready}";
    }

    // The first layer of the effect whose colours cycle; the colours set here go to every such layer of it
    static EffectLayer CycleOf( Effect effect ) => effect.Layers.FirstOrDefault( x => x.ColorModeIs != LayerColorMode.Fixed );

    static string ModeName( LayerColorMode mode ) => mode switch
    {
        LayerColorMode.Rain => "Rain",
        LayerColorMode.Cycl => "Cycle",
        LayerColorMode.Mix => "Mixed",
        _ => "Scanner",
    };

    // The scanner has a highlight and the rest; the other cycles go through their colours in order
    static string ColourLabel( LayerColorMode mode, int index ) => mode == LayerColorMode.Cyln ? (index == 0 ? "Highlight" : "Rest") : $"Color {index + 1}";

    void UseCycleColours( Effect effect, List<string> colours )
    {
        foreach ( var layer in effect.Layers.Where( x => x.ColorModeIs != LayerColorMode.Fixed ) )
            layer.Palette = colours is null ? null : new List<string>( colours );

        Changed?.Invoke();
        StateHasChanged();
    }

    // A colour set; Remove takes it out of the cycle (at least one stays), the scanner's Reset puts the game's back
    void SetCycleColour( Effect effect, int index, string hex )
    {
        var cycle = CycleOf( effect );
        var colours = cycle.CycleColours().ToList();
        var defaults = new EffectLayer { ColorMode = cycle.ColorMode }.CycleColours();

        if ( !string.IsNullOrEmpty( hex ) )
            colours[ index ] = hex;
        else if ( cycle.ColorModeIs == LayerColorMode.Cyln )
            colours[ index ] = defaults[ index ];
        else if ( colours.Count > 1 )
            colours.RemoveAt( index );

        UseCycleColours( effect, colours.SequenceEqual( defaults, StringComparer.OrdinalIgnoreCase ) ? null : colours );
    }

    void AddCycleColour( Effect effect )
    {
        var colours = CycleOf( effect ).CycleColours().ToList();
        if ( colours.Count >= EffectLayer.MaxPalette )
            return;

        colours.Add( colours[ ^1 ] );
        UseCycleColours( effect, colours );
    }

    // The budget every player's effects show within on this server: what the preview shows, and what others see
    static EffectBudget Budget => Selector?.EffectsBudget ?? EffectBudget.Normal;

    // Why an effect worn doesn't show whole, for its row
    static string WaitingText( Effect effect, int waiting ) => waiting == 0 ? null
        : waiting == effect.LayersOn()
            ? "Over this server's budget: it doesn't show until effects before it are removed or switched off."
            : $"Over this server's budget: {waiting} of its layers don't show until effects before it are removed or switched off.";

    // How much of the server's budget what is worn takes, and what happens past it
    string BudgetText()
    {
        var budget = Budget;
        var shown = Look.Effects.Where( x => !x.Off ).ToList();
        var layers = shown.Sum( x => x.LayersOn() );
        var lights = shown.Sum( x => x.Lights() );
        var used = $"Your effects use {layers} of the {budget.Layers} layers and {lights} of the {budget.Lights} lights this server allows each player.";

        return budget.Fits( Look.Effects )
            ? used
            : $"{used} Past that, the last layers and lights wait (marked over budget) and the sprites thin out until you remove some. The preview shows what others see.";
    }

    static List<UIDropdown.Item> Qualities() => new()
    {
        new( "High (as the host allows)", EffectBudget.Quality.High ),
        new( "Normal", EffectBudget.Quality.Normal ),
        new( "Low", EffectBudget.Quality.Low ),
        new( "Off", EffectBudget.Quality.Off ),
    };

    void SetQuality( object value )
    {
        if ( value is EffectBudget.Quality quality && Selector is { } selector )
            selector.EffectsQuality = quality;

        StateHasChanged();
    }

    // Everyone connected but this player
    static List<Connection> Others() => Connection.All.Where( x => x != Connection.Local ).ToList();

    void Hide( Connection connection, bool hidden )
    {
        Selector?.SetEffectsHidden( connection, hidden );
        StateHasChanged();
    }
}

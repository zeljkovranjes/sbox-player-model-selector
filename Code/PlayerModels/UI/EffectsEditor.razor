    IReadOnlyList<Draft> MyDrafts => PlayerModels.Engine.Drafts.Of( Draft.Of.Effect );

    bool IsDraft( Effect effect ) => DraftsOpen?.Effects.ContainsKey( effect.Id ) == true;

    // A draft's effect, within bounds, for its tile; null for one that doesn't read
    static Effect DraftEffect( Draft draft ) => Effect.ParseShared( draft.Item );

    void Act( PanelEvent e, Action action )
    {
        e.StopPropagation();
        action();
    }

    // A draft goes on, as a draft, and opens in the Advanced editor as it was left; one open already is selected
    void OpenDraft( Draft draft )
    {
        foreach ( var (effectId, draftId) in DraftsOpen?.Effects ?? new Dictionary<string, string>() )
        {
            if ( draftId == draft.Id && Look.Effects.Exists( x => x.Id == effectId ) )
            {
                _selected = effectId;
                OpenAdvanced?.Invoke( effectId );
                return;
            }
        }

        if ( DraftEffect( draft ) is not { } effect || DraftsOpen is null )
        {
            _status = "This draft can't be read any more.";
            StateHasChanged();
            return;
        }

        var copy = EffectPresets.Copy( effect, Look.Effects );
        if ( IsFull || LayersWorn() + copy.Layers.Count > Effect.MaxLookLayers || !Look.Adopt( copy ) )
        {
            _status = $"There's no room for it: a look wears up to {Effect.MaxWorn} effects and {Effect.MaxLookLayers} layers. Remove one first.";
            StateHasChanged();
            return;
        }

        DraftsOpen.Effects[ copy.Id ] = draft.Id;
        DraftsOpen.States[ copy.Id ] = draft.State;
        DraftsOpen.Changed();
        _selected = copy.Id;
        _status = null;
        Changed?.Invoke();
        OpenAdvanced?.Invoke( copy.Id );
    }

    void KeepDraft( Effect effect, bool dropOldest )
    {
        _confirmDrop = null;
        if ( DraftsOpen is null )
            return;

        if ( DraftsOpen.KeepEffect( Look, effect, null, dropOldest, out var dropped, out var full ) )
            _status = (dropped is null ? "" : $"\"{dropped.Name}\" was dropped. ") + $"Saved \"{effect.Name}\" as a draft: it isn't worn until you finish it.";
        else if ( full )
            _confirmDrop = PlayerModels.Engine.Drafts.Oldest( Draft.Of.Effect );
        else
            _status = "This draft is too big to keep.";

        StateHasChanged();
    }

    static string DropText( Draft oldest ) => $"Drafts are full ({Draft.MaxPerKind}). Drop the oldest, \"{oldest.Name}\" ({oldest.EditedText( PlayerModels.Engine.Drafts.Now )})?";

    void CancelDrop()
    {
        _confirmDrop = null;
        StateHasChanged();
    }

    // A copy of what is worn, beside it, carrying its drawn shapes
    void Duplicate( Effect effect )
    {
        if ( IsFull || Look.Standalone( effect ) is not { } standalone )
            return;

        var copy = EffectPresets.Copy( standalone, Look.Effects );
        copy.Name = SharePost.Tidy( $"{effect.Name} copy", Effect.MaxNameLength );
        if ( LayersWorn() + copy.Layers.Count > Effect.MaxLookLayers || !Look.Adopt( copy ) )
        {
            _status = $"There's no room for a copy: a look wears up to {Effect.MaxWorn} effects and {Effect.MaxLookLayers} layers.";
            StateHasChanged();
            return;
        }

        _selected = copy.Id;
        Changed?.Invoke();
    }


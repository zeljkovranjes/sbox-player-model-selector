@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using PlayerModels.Components
@using PlayerModels.Core
@using PlayerModels.Engine
@inherits Panel
@namespace PlayerModels.UI

<root>
    @if ( _guides )
    {
        <EffectGuides Back=@(() => ShowGuides( false ))></EffectGuides>
    }
    else if ( Look is null )
    {
        <div class="note">Loading your look...</div>
    }
    else
    {
        <div class="top">
            <div class="intro">Click an effect to put it on: the preview shows it, and Apply wears it.</div>
            <div class="tool @( History?.CanUndo == true ? "" : "disabled" )" Tooltip="Undo the last change to your effects" @onclick=@(() => Undo?.Invoke())>undo</div>
            <div class="tool @( History?.CanRedo == true ? "" : "disabled" )" Tooltip="Redo" @onclick=@(() => Redo?.Invoke())>redo</div>
            <div class="reset" Tooltip="What each part of an effect is, and how to do the harder things" @onclick=@(() => ShowGuides( true ))>Guides</div>
            <div class="reset @( Selected is null ? "disabled" : "" )" Tooltip=@( Selected is null ? "Select an effect you wear first" : "Every layer of it, placed by hand" )
                 @onclick=@(() => OpenAdvanced?.Invoke( Selected?.Id ))>Edit in Advanced editor</div>
        </div>

        @if ( Locked )
        {
            <div class="note">The host keeps effects off on this server, so nobody sees yours. They stay with your look and come back when the host turns them on.</div>
        }

        <div class="section-header">Effects</div>
        <div class="grid">
            @foreach ( var preset in EffectPresets.All )
            {
                var shown = preset;
                <div class="tile effect @( IsFull ? "disabled" : "" )" @onclick=@(() => Add( shown ))>
                    <EffectIcon class="thumb" Effect=@shown></EffectIcon>
                    <div class="title">@shown.Name</div>
                </div>
            }
            @for ( var i = 0; i < FillersFor( EffectPresets.All.Count ); i++ )
            {
                <div class="tile-filler"></div>
            }
        </div>
        @if ( IsFull )
        {
            <div class="note">You wear as many effects as a look can (@Effect.MaxWorn). Remove one to put on another.</div>
        }

        <div class="section-header">My Effects</div>
        @if ( Mine.Count == 0 )
        {
            <div class="note">Effects you keep show here, to put on again. Select one you wear and save it below its sliders.</div>
        }
        else
        {
            <div class="grid">
                @foreach ( var kept in Mine )
                {
                    var shown = kept;
                    <div class="tile effect @( IsFull ? "disabled" : "" )" Tooltip=@KeptTooltip( shown ) @onclick=@(() => Add( shown ))>
                        <EffectIcon class="thumb" Effect=@shown></EffectIcon>
                        <div class="title">@shown.Name</div>
                        <div class="forget" Tooltip="Delete from My effects" @onclick=@(( PanelEvent e ) => Forget( shown, e ))>delete</div>
                    </div>
                }
                @for ( var i = 0; i < FillersFor( Mine.Count ); i++ )
                {
                    <div class="tile-filler"></div>
                }
            </div>
        }
        @if ( _status is not null )
        {
            <div class="note status">@_status</div>
        }

        @if ( Look.Effects.Count > 0 )
        {
            <div class="section-header">Wearing</div>
            var held = Budget.HeldBack( Look.Effects );
            @for ( var i = 0; i < Look.Effects.Count; i++ )
            {
                var effect = Look.Effects[ i ];
                var waiting = held[ i ].Count( x => x );
                <div class="row worn @( effect.Id == _selected ? "selected" : "" ) @( waiting > 0 ? "over" : "" )"
                     Tooltip=@WaitingText( effect, waiting ) @onclick=@(() => Select( effect ))>
                    <div class="switch @( effect.Off ? "" : "on" )" Tooltip=@( effect.Off ? "Turn on" : "Turn off" )
                         @onclick=@(( PanelEvent e ) => Toggle( effect, e ))>check</div>
                    <div class="worn-name">@effect.Name</div>
                    @if ( waiting > 0 )
                    {
                        <div class="over-note">Over this server's budget</div>
                    }
                    <div class="icon-button" Tooltip="Remove" @onclick=@(( PanelEvent e ) => Remove( effect, e ))>delete</div>
                </div>
            }
            <div class="note">@BudgetText()</div>
        }

        @if ( Selected is { } selected )
        {
            <div class="section-header">@selected.Name</div>
            <SliderRow Label="Color" Value=@selected.Hue OnChanged=@(( float value ) => Set( () => selected.Hue = value ))></SliderRow>
            <SliderRow Label="Size" Signed=@true Value=@selected.Size OnChanged=@(( float value ) => Set( () => selected.Size = value ))></SliderRow>
            <SliderRow Label="Amount" Signed=@true Value=@selected.Amount OnChanged=@(( float value ) => Set( () => selected.Amount = value ))></SliderRow>
            <SliderRow Label="Speed" Signed=@true Value=@selected.Speed OnChanged=@(( float value ) => Set( () => selected.Speed = value ))></SliderRow>
            <div class="row">
                <div class="reset @( IsAsMade( selected ) ? "disabled" : "" )" @onclick=@(() => ResetSliders( selected ))>Reset sliders</div>
            </div>
            <div class="row">
                <div class="label">Keep it</div>
                <TextEntry class="key-entry" Placeholder=@( string.IsNullOrEmpty( selected.Name ) ? "Its name" : selected.Name ) MaxLength=@Effect.MaxNameLength
                           Value:bind=@_keepName @onsubmit=@(() => Keep( selected ))></TextEntry>
                <div class="reset @( Mine.Count >= LocalPrefs.MaxMyEffects ? "disabled" : "" )" @onclick=@(() => Keep( selected ))>Save to My effects</div>
            </div>

            <div class="row">
                <div class="label">Key</div>
                <TextEntry class="key-entry" Placeholder="None, always shows" Value:bind=@KeyText AutoComplete=@KeysMatching></TextEntry>
                <KeyGlyph class="key-glyph" Key=@selected.Key></KeyGlyph>
                <div class="reset @( selected.Key is null ? "disabled" : "" )" @onclick=@(() => SetKey( selected, null ))>Clear</div>
            </div>
            <div class="note">@KeyNote( selected )</div>

            @if ( CycleOf( selected ) is { } cycle )
            {
                var mode = cycle.ColorModeIs;
                var colours = cycle.CycleColours();
                <div class="subheading">@ModeName( mode ) colors</div>
                @for ( var i = 0; i < colours.Count; i++ )
                {
                    var index = i;
                    <ColorRow Label=@ColourLabel( mode, index ) Hex=@colours[ index ] OnChanged=@(( string hex ) => SetCycleColour( selected, index, hex ))
                              ResetLabel=@( mode == LayerColorMode.Cyln ? "Reset" : "Remove" ) CanReset=@( mode == LayerColorMode.Cyln || colours.Count > 1 )></ColorRow>
                }
                <div class="row">
                    @if ( mode != LayerColorMode.Cyln )
                    {
                        <div class="reset @( colours.Count < EffectLayer.MaxPalette ? "" : "disabled" )" @onclick=@(() => AddCycleColour( selected ))>Add color</div>
                    }
                    <div class="reset @( cycle.Palette is null ? "disabled" : "" )" @onclick=@(() => UseCycleColours( selected, null ))>Game colors</div>
                </div>
            }
        }
    }

    @if ( Selector is { } selector && !_guides )
    {
        <div class="section-header">What You See</div>
        <div class="setting">
            <div class="label">Effects quality</div>
            <UIDropdown Items=@Qualities() Value=@selector.EffectsQuality ValueChanged=@SetQuality Tokenize=@false></UIDropdown>
        </div>
        @foreach ( var player in Others() )
        {
            var connection = player;
            <ToggleRow Label=@( $"Hide {connection.DisplayName}'s effects" ) Value=@selector.HidesEffectsOf( connection )
                       OnChanged=@(( bool hidden ) => Hide( connection, hidden ))></ToggleRow>
        }
        <div class="note">Only on your screen, and never more than the host allows. Lower quality shows fewer sprites and lights on everyone, you too.</div>
    }
</root>

@code
{
    /// <summary>The look being edited. Changed in place; <see cref="Changed"/> says when.</summary>
    [Parameter] public PlayerLook Look { get; set; }

    /// <summary>Called after every change to <see cref="Look"/>.</summary>
    [Parameter] public Action Changed { get; set; }

    /// <summary>Whether the host keeps this player's effects off: they are kept, and can still be changed.</summary>
    [Parameter] public bool Locked { get; set; }

    /// <summary>Opens the Advanced editor on the effect given, by id.</summary>
    [Parameter] public Action<string> OpenAdvanced { get; set; }

    /// <summary>The steps back and forward through changes to the effects, and what takes them.</summary>
    [Parameter] public EditHistory History { get; set; }
    [Parameter] public Action Undo { get; set; }
    [Parameter] public Action Redo { get; set; }

    static PlayerModelSelector Selector => PlayerModelSelector.Find( Game.ActiveScene );

    // Five tiles to a row like the Models grid, the last row made up with fillers so its tiles keep their width
    const int TilesPerRow = 5;

    static int FillersFor( int tiles ) => (TilesPerRow - tiles % TilesPerRow) % TilesPerRow;

    // The worn effect the sliders change, by id
    string _selected;

    // Whether the guides show in place of the effects
    bool _guides;

    void ShowGuides( bool show )
    {
        _guides = show;
        StateHasChanged();
    }

    Effect Selected => Look?.Effects.FirstOrDefault( x => x.Id == _selected );

    bool IsFull => Look.Effects.Count >= Effect.MaxWorn;

    protected override int BuildHash() => HashCode.Combine( Look?.Serialize(), _selected, _guides, Locked, Selector?.EffectsBudget, Selector?.EffectsQuality,
        string.Join( ";", Others().Select( x => $"{x.Id}{Selector?.HidesEffectsOf( x )}" ) ),
        HashCode.Combine( (int)(Selector?.TriggerWait() ?? 0f), History?.CanUndo, History?.CanRedo, _mineRevision, _status ) );

    // My effects, read once and again after each change to them
    List<Effect> _mine;
    int _mineRevision;
    string _keepName;
    string _status;

    List<Effect> Mine => _mine ??= LocalPrefs.MyEffects();

    // A copy of the preset (or of one kept in My effects), selected for its sliders
    void Add( Effect preset )
    {
        if ( IsFull )
            return;

        var effect = EffectPresets.Copy( preset, Look.Effects );
        if ( !Look.Adopt( effect ) )
        {
            _status = $"A look carries up to {DrawnShape.MaxPerLook} drawn shapes, and this would take it past that. Remove an effect with drawn shapes first.";
            StateHasChanged();
            return;
        }

        _selected = effect.Id;
        _status = null;
        Changed?.Invoke();
    }

    // Keeps the selected effect in My effects, under the name typed (its own name when none is)
    void Keep( Effect effect )
    {
        var name = string.IsNullOrWhiteSpace( _keepName ) ? effect.Name : _keepName.Trim();
        var kept = Look.Standalone( effect ) ?? effect;
        kept.Name = name;
        _status = LocalPrefs.SaveMyEffect( kept ) ? $"Saved to My effects as \"{kept.Sanitized()?.Name}\"."
            : string.IsNullOrWhiteSpace( name ) ? "Give it a name first." : $"My effects is full ({LocalPrefs.MaxMyEffects}). Delete one first.";
        _keepName = null;
        _mine = null;
        _mineRevision++;
        StateHasChanged();
    }

    void Forget( Effect kept, PanelEvent e )
    {
        e.StopPropagation();
        LocalPrefs.DeleteMyEffect( kept.Name );
        _status = $"\"{kept.Name}\" is deleted from My effects.";
        _mine = null;
        _mineRevision++;
        StateHasChanged();
    }

    static string KeptTooltip( Effect kept ) => $"{kept.Layers.Count} {(kept.Layers.Count == 1 ? "layer" : "layers")}: click to put it on";

    void Select( Effect effect )
    {
        _selected = effect.Id;
        StateHasChanged();
    }

    void Toggle( Effect effect, PanelEvent e )
    {
        e.StopPropagation();
        effect.Off = !effect.Off;
        Changed?.Invoke();
    }

    void Remove( Effect effect, PanelEvent e )
    {
        e.StopPropagation();
        Look.Effects.Remove( effect );
        if ( _selected == effect.Id )
            _selected = null;

        Changed?.Invoke();
    }

    void Set( Action change )
    {
        change();
        Changed?.Invoke();
    }

    static bool IsAsMade( Effect effect ) => effect.Hue == 0f && effect.Size == 0f && effect.Amount == 0f && effect.Speed == 0f;

    void ResetSliders( Effect effect )
    {
        effect.Hue = effect.Size = effect.Amount = effect.Speed = 0f;
        Changed?.Invoke();
        StateHasChanged();
    }

    // The selected effect's key as typed: a key's name puts it on, an empty box takes it off, anything else waits for more
    string KeyText
    {
        get => Selected?.Key ?? "";
        set
        {
            if ( Selected is not { } effect )
                return;

            var key = Effect.KeyNamed( value );
            if ( key is not null || string.IsNullOrWhiteSpace( value ) )
                SetKey( effect, key );
        }
    }

    static object[] KeysMatching( string typed )
    {
        var start = typed?.Trim() ?? "";
        return Effect.Keys.Where( x => x.StartsWith( start, StringComparison.OrdinalIgnoreCase ) ).Cast<object>().ToArray();
    }

    void SetKey( Effect effect, string key )
    {
        if ( effect.Key == key )
            return;

        effect.Key = key;
        Changed?.Invoke();
        StateHasChanged();
    }

    // What a key does, and how long until one works again
    string KeyNote( Effect effect )
    {
        var minutes = (int)(Effect.TriggerCooldownSeconds / 60f);
        if ( effect.Key is null )
            return $"Give it a key and it shows only when you press it, for {Effect.TriggerSeconds:0} seconds. Effect keys work once every {minutes} minutes.";

        var wait = Selector?.TriggerWait() ?? 0f;
        var ready = wait > 0f ? $" Your next one in {(int)wait / 60}:{(int)wait % 60:00}." : "";
        return $"Press {effect.Key.ToUpperInvariant()} and it shows for {Effect.TriggerSeconds:0} seconds, for everyone. Effect keys work once every {minutes} minutes, whichever effect they are for.{ready}";
    }

    // The first layer of the effect whose colours cycle; the colours set here go to every such layer of it
    static EffectLayer CycleOf( Effect effect ) => effect.Layers.FirstOrDefault( x => x.ColorModeIs != LayerColorMode.Fixed );

    static string ModeName( LayerColorMode mode ) => mode switch
    {
        LayerColorMode.Rain => "Rain",
        LayerColorMode.Cycl => "Cycle",
        LayerColorMode.Mix => "Mixed",
        _ => "Scanner",
    };

    // The scanner has a highlight and the rest; the other cycles go through their colours in order
    static string ColourLabel( LayerColorMode mode, int index ) => mode == LayerColorMode.Cyln ? (index == 0 ? "Highlight" : "Rest") : $"Color {index + 1}";

    void UseCycleColours( Effect effect, List<string> colours )
    {
        foreach ( var layer in effect.Layers.Where( x => x.ColorModeIs != LayerColorMode.Fixed ) )
            layer.Palette = colours is null ? null : new List<string>( colours );

        Changed?.Invoke();
        StateHasChanged();
    }

    // A colour set; Remove takes it out of the cycle (at least one stays), the scanner's Reset puts the game's back
    void SetCycleColour( Effect effect, int index, string hex )
    {
        var cycle = CycleOf( effect );
        var colours = cycle.CycleColours().ToList();
        var defaults = new EffectLayer { ColorMode = cycle.ColorMode }.CycleColours();

        if ( !string.IsNullOrEmpty( hex ) )
            colours[ index ] = hex;
        else if ( cycle.ColorModeIs == LayerColorMode.Cyln )
            colours[ index ] = defaults[ index ];
        else if ( colours.Count > 1 )
            colours.RemoveAt( index );

        UseCycleColours( effect, colours.SequenceEqual( defaults, StringComparer.OrdinalIgnoreCase ) ? null : colours );
    }

    void AddCycleColour( Effect effect )
    {
        var colours = CycleOf( effect ).CycleColours().ToList();
        if ( colours.Count >= EffectLayer.MaxPalette )
            return;

        colours.Add( colours[ ^1 ] );
        UseCycleColours( effect, colours );
    }

    // The budget every player's effects show within on this server: what the preview shows, and what others see
    static EffectBudget Budget => Selector?.EffectsBudget ?? EffectBudget.Normal;

    // Why an effect worn doesn't show whole, for its row
    static string WaitingText( Effect effect, int waiting ) => waiting == 0 ? null
        : waiting == effect.LayersOn()
            ? "Over this server's budget: it doesn't show until effects before it are removed or switched off."
            : $"Over this server's budget: {waiting} of its layers don't show until effects before it are removed or switched off.";

    // How much of the server's budget what is worn takes, and what happens past it
    string BudgetText()
    {
        var budget = Budget;
        var shown = Look.Effects.Where( x => !x.Off ).ToList();
        var layers = shown.Sum( x => x.LayersOn() );
        var lights = shown.Sum( x => x.Lights() );
        var used = $"Your effects use {layers} of the {budget.Layers} layers and {lights} of the {budget.Lights} lights this server allows each player.";

        return budget.Fits( Look.Effects )
            ? used
            : $"{used} Past that, the last layers and lights wait (marked over budget) and the sprites thin out until you remove some. The preview shows what others see.";
    }

    static List<UIDropdown.Item> Qualities() => new()
    {
        new( "High (as the host allows)", EffectBudget.Quality.High ),
        new( "Normal", EffectBudget.Quality.Normal ),
        new( "Low", EffectBudget.Quality.Low ),
        new( "Off", EffectBudget.Quality.Off ),
    };

    void SetQuality( object value )
    {
        if ( value is EffectBudget.Quality quality && Selector is { } selector )
            selector.EffectsQuality = quality;

        StateHasChanged();
    }

    // Everyone connected but this player
    static List<Connection> Others() => Connection.All.Where( x => x != Connection.Local ).ToList();

    void Hide( Connection connection, bool hidden )
    {
        Selector?.SetEffectsHidden( connection, hidden );
        StateHasChanged();
    }
}
